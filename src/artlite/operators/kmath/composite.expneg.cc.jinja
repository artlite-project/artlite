// e^(-|x|) of {{ N }} fp32 lanes (kmath.expneg, in (0, 1]: {{ bound }} for x in [-87, 87]; kmath.exp's error, ~1.6e-5 |x|:
// 2^-15.8 for |x| <= 1)
{{ attr }} aie::vector<float, {{ N }}> {{ name }}(aie::vector<float, {{ N }}> x)
{
    const aie::vector<float, {{ N }}> ax = aie::max(x, aie::sub(aie::zeros<float, {{ N }}>(), x));
    return {{ exp }}(aie::sub(aie::zeros<float, {{ N }}>(), ax));
}
