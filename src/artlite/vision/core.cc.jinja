// a head's bf16 C tile [rb][cb][64] RMS-normed per token in place (C_QKN: LFM3-VL's q / k norm): the sum of squares
// of its 80 channels (pads zero) times C_INVN plus C_EPS, c := bf16(c w) rsqrt(..) (the inverse as hi + lo bf16), w the
// command's 80 bf16 at C_QKW
static __attribute__((noinline)) void {{ p }}_qkn(bfloat16 *__restrict c, const int32_t *ws, int nrb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  const bfloat16 *w = (const bfloat16 *)(ws + {{ C_QKW }});
  const aie::vector<float, 16> inv_n = aie::broadcast<int32, 16>(ws[{{ C_INVN }}]).template cast_to<float>();
  const aie::vector<float, 16> eps = aie::broadcast<int32, 16>(ws[{{ C_EPS }}]).template cast_to<float>();
  for (int rb = 0; rb < nrb; rb++) {
    bfloat16 *x = c + 640 * rb;
    aie::accum<accfloat, 64> a2 = aie::zeros<accfloat, 64>();
    for (int cb = 0; cb < 10; cb++) {
      const aie::vector<bfloat16, 64> v = aie::load_v<64>(x + 64 * cb);
      a2 = aie::mac(a2, v, v);
    }
    const aie::vector<float, 16> ve = aie::add(al::mulff<16>(al::group8<false>(a2.template to_vector<float>()).template grow<16>(), inv_n), eps);
    aie::vector<float, 16> r = aie::zeros<float, 16>();
    AIE_LOOP_UNROLL_FULL
    for (int k = 0; k < 8; k++) r.set(aie::invsqrt(ve[k]), k);
    aie::vector<bfloat16, 16> rh, rl;
    al::split2<16>(r, rh, rl);
    const aie::vector<bfloat16, 64> h = al::expand8(rh.extract<8>(0)), l = al::expand8(rl.extract<8>(0));
    for (int cb = 0; cb < 10; cb++) {
      const aie::vector<bfloat16, 64> cw = aie::mul(aie::load_v<64>(x + 64 * cb), {{ p }}_rep(w + 8 * cb)).template to_vector<bfloat16>();
      aie::store_v(x + 64 * cb, aie::mac(aie::mul(cw, h), cw, l).template to_vector<bfloat16>());
    }
  }
}

// the heads of two passes (C_ROPE2, m 16) RMS-normed per token in place: a (pass A) and b (pass B), bf16 [rb][cb][64];
// the sum of squares of both (pads zero) times C_INVN plus C_EPS; a := bf16(a w) rsqrt(..), b := bf16(b w') rsqrt(..)
// (``{{ p }}_qkn``'s steps), w, w' the command's 160 bf16 at C_QKW
static __attribute__((noinline)) void {{ p }}_qkn2(bfloat16 *__restrict a, bfloat16 *__restrict b, const int32_t *ws, int nrb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  const bfloat16 *w = (const bfloat16 *)(ws + {{ C_QKW }});
  const aie::vector<float, 16> inv_n = aie::broadcast<int32, 16>(ws[{{ C_INVN }}]).template cast_to<float>();
  const aie::vector<float, 16> eps = aie::broadcast<int32, 16>(ws[{{ C_EPS }}]).template cast_to<float>();
  for (int rb = 0; rb < nrb; rb++) {
    aie::accum<accfloat, 64> a2 = aie::zeros<accfloat, 64>();
    for (int cb = 0; cb < 20; cb++) {
      const aie::vector<bfloat16, 64> v = aie::load_v<64>((cb < 10 ? a : b) + 640 * rb + 64 * (cb % 10));
      a2 = aie::mac(a2, v, v);
    }
    const aie::vector<float, 16> ve = aie::add(al::mulff<16>(al::group8<false>(a2.template to_vector<float>()).template grow<16>(), inv_n), eps);
    aie::vector<float, 16> r = aie::zeros<float, 16>();
    AIE_LOOP_UNROLL_FULL
    for (int k = 0; k < 8; k++) r.set(aie::invsqrt(ve[k]), k);
    aie::vector<bfloat16, 16> rh, rl;
    al::split2<16>(r, rh, rl);
    const aie::vector<bfloat16, 64> h = al::expand8(rh.extract<8>(0)), l = al::expand8(rl.extract<8>(0));
    for (int cb = 0; cb < 20; cb++) {
      bfloat16 *x = (cb < 10 ? a : b) + 640 * rb + 64 * (cb % 10);
      const aie::vector<bfloat16, 64> cw = aie::mul(aie::load_v<64>(x), {{ p }}_rep(w + 8 * cb)).template to_vector<bfloat16>();
      aie::store_v(x, aie::mac(aie::mul(cw, h), cw, l).template to_vector<bfloat16>());
    }
  }
}

// 1 + 2^y of n fp32 values (``{{ exp2 }}``: bf16-level, saturating outside +-63.5) -> bf16 at y (in place: out may be
// y's start); the gate's GEMM's weights are -log2 e times LFM3's attention gate's: 1 / sigmoid of its logits
static __attribute__((noinline)) void {{ p }}_isig(const float *y, bfloat16 *out, int n) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  for (int i = 0; i < n; i += 32) {
    const aie::accum<accfloat, 32> A = aie::add(aie::accum<accfloat, 32>(aie::load_v<32>(y + i)), aie::broadcast<float, 32>(192.0f));
    aie::store_v(out + i, aie::add({{ exp2 }}(A), aie::broadcast<float, 32>(1.0f)).template to_vector<bfloat16>());
  }
}

// a pass of two heads of 40 channels (C_EPI E_ROPE40, m 16: LFM3-Audio's depthformer, heads of 32 in 40) RMS-normed per
// token over each head's channel blocks 0 .. 3 (C_INVN, C_EPS, w the command's 80 bf16 at C_QKW: ``{{ p }}_qkn``'s
// steps; blocks 4, 9 the pads) and turned in place: per head the pairs (cb, cb + 2) of cb 0, 1 by the table t ([rb][cb]
// [64] bf16: cos in cb 0, 1, sin in cb 2, 3, both heads')
static __attribute__((noinline)) void {{ p }}_rope40(bfloat16 *__restrict c, const bfloat16 *__restrict t, const int32_t *ws,
                                                int nrb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  const bfloat16 *w = (const bfloat16 *)(ws + {{ C_QKW }});
  const aie::vector<float, 16> inv_n = aie::broadcast<int32, 16>(ws[{{ C_INVN }}]).template cast_to<float>();
  const aie::vector<float, 16> eps = aie::broadcast<int32, 16>(ws[{{ C_EPS }}]).template cast_to<float>();
  for (int rb = 0; rb < nrb; rb++) {
    for (int hd = 0; hd < 2; hd++) {
      bfloat16 *x = c + 640 * rb + 320 * hd;
      aie::accum<accfloat, 64> a2 = aie::zeros<accfloat, 64>();
      for (int cb = 0; cb < 4; cb++) {
        const aie::vector<bfloat16, 64> v = aie::load_v<64>(x + 64 * cb);
        a2 = aie::mac(a2, v, v);
      }
      const aie::vector<float, 16> ve = aie::add(al::mulff<16>(al::group8<false>(a2.template to_vector<float>()).template grow<16>(), inv_n), eps);
      aie::vector<float, 16> r = aie::zeros<float, 16>();
      AIE_LOOP_UNROLL_FULL
      for (int k = 0; k < 8; k++) r.set(aie::invsqrt(ve[k]), k);
      aie::vector<bfloat16, 16> rh, rl;
      al::split2<16>(r, rh, rl);
      const aie::vector<bfloat16, 64> h = al::expand8(rh.extract<8>(0)), l = al::expand8(rl.extract<8>(0));
      for (int cb = 0; cb < 4; cb++) {
        const aie::vector<bfloat16, 64> cw = aie::mul(aie::load_v<64>(x + 64 * cb), {{ p }}_rep(w + 40 * hd + 8 * cb)).template to_vector<bfloat16>();
        aie::store_v(x + 64 * cb, aie::mac(aie::mul(cw, h), cw, l).template to_vector<bfloat16>());
      }
      for (int a = 0; a < 2; a++) {
        const aie::vector<bfloat16, 64> vx = aie::load_v<64>(x + 64 * a), vy = aie::load_v<64>(x + 64 * (a + 2));
        const aie::vector<bfloat16, 64> vc = aie::load_v<64>(t + 640 * rb + 64 * a), vs = aie::load_v<64>(t + 640 * rb + 64 * (a + 2));
        aie::store_v(x + 64 * a, aie::msc(aie::mul(vx, vc), vy, vs).template to_vector<bfloat16>());
        aie::store_v(x + 64 * (a + 2), aie::mac(aie::mul(vy, vc), vx, vs).template to_vector<bfloat16>());
      }
    }
  }
}

// K_GEMM's RoPE epilogue (role r, the module docstring): the pass's fp32 C tile to bf16 in place (with C_QKN each
// head RMS-normed: ``{{ p }}_qkn``), its C_NRES residual objects (the tokens' cos | sin, m x 80 bf16) into the C buffer
// after it, the pairs turned, the tile -> bfp16 panels out. C_ROPE2 (m 16, a head in two passes, A then B: the
// residual object its tables [A | B]): pass A's bf16 tile kept (words 1280 ..), nothing out; at pass B both normed
// (``{{ p }}_qkn2``), turned by their tables (words 1920 ..), A's panels then B's out
__attribute__((noinline, minsize)) void {{ p }}_ext_r({{ p }}_st &s, int32_t *cb, int32_t *ws, int32_t *) {
  const int m = ws[{{ C_M }}], nres = ws[{{ C_NRES }}];
  {{ p }}_res_f2b((const bfloat16 *)(ws + {{ C_ZERO }}), (const float *)cb, (bfloat16 *)cb, m * 80, 0, 0);
  if (ws[{{ C_ROPE2 }}]) {
    int32_t *ka = cb + 1280, *t = cb + 1920, *a = {{ p }}_take_a(s);
    if (ws[{{ C_ROPE2 }}] == 1)
      {{ p }}_copy8(cb, ka, 640);
    else {  // (the tables: 1280 words, over the object's halves)
      {{ p }}_copy8(a, t, {{ A_OBJ // 8 }});
      {{ p }}_copy8({{ p }}_aw(a, {{ A_OBJ // 8 }}), t + {{ A_OBJ // 8 }}, {{ 1280 - A_OBJ // 8 }});
    }
    {{ p }}_give_a(s, a);
    if ((ws[{{ C_ROPE2 }}] ^= 3) == 2)
      return;
    {{ p }}_qkn2((bfloat16 *)ka, (bfloat16 *)cb, ws, 2);
    {{ p }}_rope((bfloat16 *)ka, (const bfloat16 *)t, 2);
    {{ p }}_rope((bfloat16 *)cb, (const bfloat16 *)(t + 640), 2);
    {{ p }}_bfp(ka, ka, 20);
    {{ p }}_out(s, ka, 1440);
    {{ p }}_bfp(cb, cb, 20);
    {{ p }}_out(s, cb, 1440);
    return;
  }
  if (ws[{{ C_QKN }}]) {{ p }}_qkn((bfloat16 *)cb, ws, m / 8);
  int32_t *t = cb + m * 40;  // (words: the table after the bf16 tile, in the C buffer's other region)
  for (int i = 0, left = m * 40; i < nres; i++) {
    int32_t *a = {{ p }}_take_a(s);
    const int n = left < {{ A_OBJ // 4 }} ? left : {{ A_OBJ // 4 }}, n0 = n < {{ A_OBJ // 8 }} ? n : {{ A_OBJ // 8 }};
    {{ p }}_copy8(a, t, n0);
    if (n > n0)
      {{ p }}_copy8({{ p }}_aw(a, {{ A_OBJ // 8 }}), t + n0, n - n0);
    t += n;
    left -= n;
    {{ p }}_give_a(s, a);
  }
  {{ p }}_rope((bfloat16 *)cb, (const bfloat16 *)(cb + m * 40), m / 8);
  {{ p }}_bfp(cb, cb, m / 8 * 10);
  {{ p }}_out(s, cb, m * 90);
}

// K_GEMM's epilogues of LFM3-Audio's generator (role e, at O_ROPE: the pass's fp32 C tile in cb): C_EPI E_F32 the fp32
// tile out as it is; E_GATE 1 + 2^y (``{{ p }}_isig``) as bf16 out; E_ROPE40 (m 16) to bf16, the residual object the
// tile's table, two heads of 40 normed and turned (``{{ p }}_rope40``), bfp16 panels out
__attribute__((noinline, minsize)) void {{ p }}_ext_e({{ p }}_st &s, int32_t *cb, int32_t *ws, int32_t *) {
  const int m = ws[{{ C_M }}], epi = ws[{{ C_EPI }}];
  if (epi == {{ E_F32 }}) {
    {{ p }}_out(s, cb, m * 320);
  } else if (epi == {{ E_GATE }}) {
    {{ p }}_isig((const float *)cb, (bfloat16 *)cb, m * 80);
    {{ p }}_out(s, cb, m * 160);
  } else {
    {{ p }}_res_f2b((const bfloat16 *)(ws + {{ C_ZERO }}), (const float *)cb, (bfloat16 *)cb, m * 80, 0, 0);
    int32_t *t = cb + 640, *a = {{ p }}_take_a(s);  // (the table: 1280 words)
    {{ p }}_copy8(a, t, 640);
    {{ p }}_give_a(s, a);
    {{ p }}_rope40((bfloat16 *)cb, (const bfloat16 *)t, ws, 2);
    {{ p }}_bfp(cb, cb, 20);
    {{ p }}_out(s, cb, 1440);
  }
}

// SiLU of a C tile (role r's second and third entry: a GEMM's GELU path with role r): rb's 10 channel blocks -> silu as
// bfp16 panels [rb][10] at out (``{{ p }}_gelu``'s form; tab: SiLU's table)
__attribute__((noinline)) void {{ p }}_silu_pn(const int32_t *__restrict in, int32_t *__restrict out, bfloat16 *__restrict t,
                                          const uint32_t *__restrict tab, int nrb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  aie::block_vector_output_buffer_stream<bfp16ebs8, 64> o((bfp16ebs8 *)out);
  for (int rb = 0; rb < nrb; rb++) {
    {{ rb_act }}((const bfloat16 *)in + 640 * rb, t, tab, tab + {{ tw }});
    const bfloat16 *tv = t;
    for (int i = 0; i < 10; i++) {
      o.push(aie::accum<accfloat, 64>(aie::load_v<64>(tv)).template to_vector<bfp16ebs8>());
      tv += 64;
    }
  }
}

// SwiGLU of a C tile (role d's second entry: a GEMM's GEGLU path): rb's channels [hid 5 cb | gate 5 cb] -> hid silu(gate)
// as bfp16 panels [rb][5] at out (``{{ p }}_geglu``'s form; tab: SiLU's table)
__attribute__((noinline)) void {{ p }}_swiglu(const int32_t *__restrict in, int32_t *__restrict out, bfloat16 *__restrict t,
                                         const uint32_t *__restrict tab, int nrb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  const bfloat16 *h = (const bfloat16 *)in;
  int ch = 0;
  aie::block_vector_output_buffer_stream<bfp16ebs8, 64> o((bfp16ebs8 *)out);
  for (int rb = 0; rb < nrb; rb += 2) {
    {{ swiglu_act }}((const bfloat16 *)in + 320 + 640 * rb, t, tab, tab + {{ tw }});
    const bfloat16 *tv = t;
    for (int i = 0; i < 10; i++) {
      o.push(aie::mul(aie::load_v<64>(tv), aie::load_v<64>(h)).template to_vector<bfp16ebs8>());
      h = add_2d_ptr(h, 384, 4, ch, 64);
      tv += 64;
    }
  }
}

// a gated product of a C tile (role d's third entry: a GEMM's GELU path): rb's channels [hid 5 cb | gate 5 cb] -> bf16
// hid gate [rb][5 cb][64] at out (the tile's buffer: rb's products at 320 rb, written after its reads)
__attribute__((noinline)) void {{ p }}_prod(const int32_t *__restrict in, int32_t *__restrict out, bfloat16 *__restrict,
                                       const uint32_t *__restrict, int nrb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  const bfloat16 *x = (const bfloat16 *)in;
  bfloat16 *y = (bfloat16 *)out;
  for (int rb = 0; rb < nrb; rb++)
    for (int cb = 0; cb < 5; cb++) {
      const aie::vector<bfloat16, 64> v = aie::mul(aie::load_v<64>(x + 640 * rb + 64 * cb),
                                                   aie::load_v<64>(x + 640 * rb + 64 * cb + 320)).template to_vector<bfloat16>();
      aie::store_v(y + 320 * rb + 64 * cb, v);
    }
}

// a class's outputs of the depthwise 3 x 3 conv (``{{ p }}_ext_d``): hb the half's 4 class slots, taps [tap 9][80] bf16,
// y the class's row block [cb][64] of the C tile; per tap its source (class q' = ((py + dy) & 1, (px + dx) & 1): the
// strip cy != 0 where cy = (py + dy) >> 1, windows from 1 + cx, cx = (px + dx) >> 1) and the class's mask words (the
// slot's 18 at DW_MASK: per tap the lanes of its valid windows); fp32 sums of 9 taps per channel, rounded to bf16, times
// C, rounded
static __attribute__((noinline)) void {{ p }}_dwq(const uint8_t *const *hb, const bfloat16 *__restrict taps, bfloat16 *__restrict y,
                                             int q) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  const int py = q >> 1, px = q & 1;
  const bfloat16 *src[9];
  const uint32_t *mw = (const uint32_t *)(hb[q] + {{ DW_MASK }});
  for (int t = 0; t < 9; t++) {
    const int dy = t / 3 - 1, dx = t % 3 - 1, sy = py + dy, sx = px + dx;
    src[t] = (const bfloat16 *)(hb[(sy & 1) * 2 + (sx & 1)] + ((sy >> 1) ? {{ DW_STRIP }} : 0) + ((sx >> 1) + 1) * 16);
  }
  const bfloat16 *c = (const bfloat16 *)(hb[q] + {{ DW_C }});
  for (int cb = 0; cb < 10; cb++) {
    aie::accum<accfloat, 64> acc = aie::zeros<accfloat, 64>();
    for (int t = 0; t < 9; t++) {
      const aie::mask<64> mk = aie::mask<64>::from_uint32(mw[2 * t], mw[2 * t + 1]);
      const aie::vector<bfloat16, 64> v = aie::select(aie::zeros<bfloat16, 64>(), al::gather<8, 8>(src[t] + 80 * cb, 8), mk);
      acc = aie::mac(acc, v, {{ p }}_rep(taps + 80 * t + 8 * cb));
    }
    aie::store_v(y + 64 * cb, aie::mul(acc.template to_vector<bfloat16>(), aie::load_v<64>(c + 64 * cb)).template to_vector<bfloat16>());
  }
}

// a strip conv's row block (``{{ p }}_dw1``): its sub-blocks cb0 .. cb0 + ncb - 1, each the fp32 sum over the taps t of
// tap t's weights (taps [tap][80], channels 8 cb ..) times 8 tokens' 8 channels from st + off[t] + 8 (cb - cb0) (the
// tokens 80 elements apart), plus the bias (or none), rounded to bf16, times c's sub-block (or not), into y
static __attribute__((noinline)) void {{ p }}_dw1rb(const bfloat16 *__restrict st, const bfloat16 *__restrict taps,
                                               const bfloat16 *__restrict bias, const bfloat16 *__restrict c,
                                               bfloat16 *__restrict y, const int32_t *off, int ntap, int cb0, int ncb) {
  aie::set_rounding(aie::rounding_mode::conv_even);
  for (int k = 0; k < ncb; k++) {
    const int ch = 8 * (cb0 + k);
    aie::accum<accfloat, 64> acc(bias ? {{ p }}_rep(bias + ch) : aie::zeros<bfloat16, 64>());
    for (int t = 0; t < ntap; t++)
      acc = aie::mac(acc, al::gather<8, 8>(st + off[t] + 8 * k, 80), {{ p }}_rep(taps + 80 * t + ch));
    aie::vector<bfloat16, 64> v = acc.template to_vector<bfloat16>();
    if (c) v = aie::mul(v, aie::load_v<64>(c + 64 * k)).template to_vector<bfloat16>();
    aie::store_v(y + 64 * (cb0 + k), v);
  }
}

// the strip conv op (K_DW1, role d, ``ops.StripConv``): one 80-channel block of the column's tile; C_NOBJ A objects (its
// row blocks: two an object in mode 1, one in mode 2),
// each two halves: mode 1 (C_DWM), half h of object o the inputs of row block 2 o + h ([strip rows][80] bf16, its C
// row block [cb 10][64] at C_DWC: y = C conv), mode 2 row block o, half h its channels 40 h .. ([strip][40] bf16 of
// DW1_STRIP values, SiLU'd first where C_DWS (into the C buffer's second half): y = conv + b); the taps (C_NTAP, B slot
// [tap][80] bf16 then the bias [80]; their offsets C_TOFF) -> the C tile [rb][cb][64], then bfp16 panels out
static __attribute__((noinline, minsize)) void {{ p }}_dw1({{ p }}_st &s, int32_t *cb, const int32_t *ws, const uint32_t *tab) {
  const int nobj = ws[{{ C_NOBJ }}], m1 = ws[{{ C_DWM }}] == 1, ntap = ws[{{ C_NTAP }}], silu = ws[{{ C_DWS }}];
  const bfloat16 *taps = (const bfloat16 *){{ p }}_take_b(s);
  bfloat16 *y = (bfloat16 *)cb, *scr = (bfloat16 *)cb + 5120;
  for (int o = 0; o < nobj; o++) {
    const uint8_t *a = (const uint8_t *){{ p }}_take_a(s);
    for (int h = 0; h < 2; h++) {
      const bfloat16 *st = (const bfloat16 *){{ p }}_ab(a, h * {{ A_OBJ // 2 }});
      if (silu) {
        {{ strip_act }}(st, scr, tab, tab + {{ tw }});
        st = scr;
      }
      {{ p }}_dw1rb(st, taps, m1 ? nullptr : taps + 80 * ntap, m1 ? st + ws[{{ C_DWC }}] : nullptr,
                    y + 640 * (m1 ? 2 * o + h : o), ws + {{ C_TOFF }}, ntap, m1 ? 0 : 5 * h, m1 ? 10 : 5);
    }
    {{ p }}_give_a(s, (int32_t *)a);
  }
  {{ p }}_give_b(s, (int32_t *)taps);
  {{ p }}_bfp(cb, cb, m1 ? 20 * nobj : 10 * nobj);  // (the objects' row blocks)
  {{ p }}_out(s, cb, m1 ? 1440 * nobj : 720 * nobj);
}

// the depthwise 3 x 3 conv op (K_DW, role d, ``ops.DwConv``): one 80-channel block of the column's tile; per half p two A
// objects of its classes' slots (q' 0, 1 | 2, 3 in the halves: [strip cy 0 | strip cy != 0: cb 10 x window 10 x 8 bf16]
// [C: cb 10 x 8 x 8][mask words]), the taps (B slot [tap 9][80] bf16); y = C conv(g) into the C tile (row block
// 2 q + p), then bfp16 panels [rb][cb] out; K_DW1: ``{{ p }}_dw1``
__attribute__((noinline, minsize)) void {{ p }}_ext_d({{ p }}_st &s, int32_t *cb, int32_t *ws, int32_t *tab) {
  if (ws[{{ C_KIND }}] == {{ K_DW1 }}) {
    {{ p }}_dw1(s, cb, ws, (const uint32_t *)tab);
    return;
  }
  int32_t *tw = {{ p }}_take_b(s);
  for (int h = 0; h < 2; h++) {
    const uint8_t *a0 = (const uint8_t *){{ p }}_take_a(s), *a1 = (const uint8_t *){{ p }}_take_a(s);
    const uint8_t *hb[4] = {a0, {{ p }}_ab(a0, {{ A_OBJ // 2 }}), a1, {{ p }}_ab(a1, {{ A_OBJ // 2 }})};
    for (int q = 0; q < 4; q++)
      {{ p }}_dwq(hb, (const bfloat16 *)tw, (bfloat16 *)cb + 640 * (2 * q + h), q);
    {{ p }}_give_a(s, (int32_t *)a0);
    {{ p }}_give_a(s, (int32_t *)a1);
  }
  {{ p }}_give_b(s, tw);
  {{ p }}_bfp(cb, cb, 80);
  {{ p }}_out(s, cb, 5760);
}

extern "C" {

// the start of every core (its first command's role arrives as a page before it)
__attribute__((noinline, minsize)) void {{ p }}_main(int32_t *r23, int32_t *outr, int32_t *cb, int32_t *ws, int32_t *tab,
                                                 int32_t *ext) {
  {{ p }}_run(r23, outr, cb, ws, tab, ext);
}

}  // extern "C"
