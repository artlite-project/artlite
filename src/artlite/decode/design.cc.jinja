// 16 fp32 in place -> e^v (one copy), 1 / v (one copy): out of line, their frames the callers' none
__attribute__((noinline)) void {{ p }}_sexp(float *__restrict v)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    aie::store_v(v, {{ cexp }}(aie::load_v<16>(v)));
}

__attribute__((noinline)) void {{ p }}_srcp(float *__restrict v)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    aie::store_v(v, {{ crcp }}(aie::load_v<16>(v)));
}

// The helper, a phase's partial sums object ps (``protocol.F_COEF``: the 8 columns' [slot 4][32] fp32, 128 floats apart:
// lanes b < 8 a state's sum of squares, 8 + 8 j + b its dot with query j) -> the coefficient sets set0 .. set0 + nq - 1
// of the mix's n states (tab: [set][state 8][slot 4] fp32): per slot and query the softmax over b < n of q_j . x_b /
// (r_b sqrt(hidden)), times 1 / r_b (r_b: the state's RMS, eps 1e-6; the other states' 0)
__attribute__((noinline, minsize)) void {{ p }}_hcoef(const float *__restrict ps, float *__restrict tab, int set0, int nq, int n)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const aie::mask<16> valid = aie::lt(aie::load_v<16>({{ p }}_iota).template unpack<int32>(), aie::broadcast<int32, 16>(n));
    alignas(64) float e[16], r[16];
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < 4; s++) {
        aie::vector<float, 32> t = aie::load_v<32>(ps + 32 * s);
        AIE_LOOP_NO_UNROLL
        for (int c = 1; c < {{ COLS }}; c++)
            t = aie::add(t, aie::load_v<32>(ps + 128 * c + 32 * s));
        const aie::vector<float, 16> ir = al::inv_rms<{{ H }}, 8>(t.template extract<16>(0), 1e-6f);  // (lanes b < 8)
        AIE_LOOP_NO_UNROLL
        for (int j = 0; j < nq; j++) {
            const aie::vector<float, 16> d = t.template extract<8>(j + 1).template grow<16>();
            aie::vector<float, 16> sc = al::mulff<16>(al::mulff<16>(d, ir), aie::broadcast<float, 16>({{ 1.0 / H ** 0.5 }}f));
            sc = aie::select(aie::broadcast<float, 16>(-1e30f), sc, valid);
            aie::store_v(e, aie::sub(sc, aie::broadcast<float, 16>(aie::reduce_max(sc))));
            {{ p }}_sexp(e);
            const aie::vector<float, 16> ev = aie::select(aie::zeros<float, 16>(), aie::load_v<16>(e), valid);
            aie::store_v(r, aie::broadcast<float, 16>(aie::reduce_add(ev)));
            {{ p }}_srcp(r);
            aie::store_v(e, al::mulff<16>(al::mulff<16>(ev, aie::load_v<16>(r)), ir));
            float *__restrict out = tab + 32 * (set0 + j) + s;
            AIE_LOOP_NO_UNROLL
            for (int b = 0; b < 8; b++)
                out[4 * b] = e[b];
        }
    }
}

// The helper, an fp32 state object (``states``: ``protocol.F_STATES``): state b's part of a k range (1024 fp32: [k block
// 128 / sp][slot sp][8]) times the slots' coefficients c (fp32 [slot 4]; nullptr: 1) into acc (first: stored, else
// added; the main core's res region, idle in these phases): x = c_hi s_hi + c_hi s_lo + c_lo s_hi (~2^-16){{ "; its first nf
// floats (a range past the input's end: what is left)" if qtails else "" }}
__attribute__((noinline)) void {{ p }}_hsacc(const float *__restrict x, const float *__restrict c, float *__restrict acc,
                                             int first, int sp{{ ", int nf" if qtails else "" }})
{
{% if not qtails %}
    constexpr int nf = 1024;
{% endif %}
    aie::set_rounding(aie::rounding_mode::conv_even);
    if (!c && first) {  // (one state, coefficient 1: its values as they are)
        {{ p }}_cv((int32_t *)acc, (const int32_t *)x, nf / 16);
        return;
    }
    // (lane l: slot (l / 8) % sp's coefficient)
    const aie::vector<float, 32> cl = c ? aie::concat(aie::broadcast<float, 8>(c[0]), aie::broadcast<float, 8>(c[1 & (sp - 1)]),
                                                       aie::broadcast<float, 8>(c[2 & (sp - 1)]), aie::broadcast<float, 8>(c[3 & (sp - 1)]))
                                        : aie::broadcast<float, 32>(1.0f);
    aie::vector<bfloat16, 32> ch, cw;
    al::split2<32>(cl, ch, cw);
    // (the whole object, past the range's nf floats its zero padding into acc's idle rest: the first state's products
    // added to zeros, 2 vectors an iteration pipelined after register allocation: 86 + 371 cycles a call; 1036 / 654 the
    // products stored / added a vector an iteration, unpipelined / pre-RA)
    if (first) {
        AIE_LOOP_NO_UNROLL
        for (int i = 0; i < 1024; i += 64) {
            aie::store_v(acc + i, aie::zeros<float, 32>());
            aie::store_v(acc + i + 32, aie::zeros<float, 32>());
        }
    }
    AIE_PREPARE_FOR_POSTPIPELINING
    for (int i = 0; i < 1024; i += 64) {
        aie::vector<bfloat16, 32> h0, l0, h1, l1;
        al::split2<32>(aie::load_v<32>(x + i), h0, l0);
        const aie::accum<accfloat, 32> a0 = aie::mac(aie::mac(aie::mac(aie::accum<accfloat, 32>(aie::load_v<32>(acc + i)), ch, h0), ch, l0), cw, h0);
        al::split2<32>(aie::load_v<32>(x + i + 32), h1, l1);
        const aie::accum<accfloat, 32> a1 = aie::mac(aie::mac(aie::mac(aie::accum<accfloat, 32>(aie::load_v<32>(acc + i + 32)), ch, h1), ch, l1), cw, h1);
        aie::store_v(acc + i, a0.template to_vector<float>());
        aie::store_v(acc + i + 32, a1.template to_vector<float>());
    }
}

