{% if SLOTS == 8 %}
        aie::store_v(gs, aie::concat(aie::accum<accfloat, 32>(g).template to_vector<bfloat16>(), aie::zeros<bfloat16, 32>()));
        {{ lut }}<64>(gs, gs + 64, (const uint32_t *)(intptr_t)ta[0], (const uint32_t *)(intptr_t)ta[1]);  // (``rows``' one)
        const aie::vector<float, 32> v = al::mulc<32>(y, aie::load_v<32>(gs + 64)).template to_vector<float>();
{% else %}
        aie::store_v(gs, aie::accum<accfloat, 32>(g).template to_vector<bfloat16>());
        {{ lut }}<32>(gs, gs + 32);
        const aie::vector<float, 32> v = al::mulc<32>(y, aie::load_v<32>(gs + 32)).template to_vector<float>();
{% endif %}
        aie::store_v(yt + 8 * s, v.template extract<8>(0));
        aie::store_v(yt + {{ 8 * SLOTS }} + 8 * s, v.template extract<8>(1));
{% if wide %}
        aie::store_v(yt + {{ 16 * SLOTS }} + 8 * s, v.template extract<8>(2));
