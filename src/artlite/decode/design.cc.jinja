    const int jn = j + 1 == na + ((fw >> {{ B_NB }}) & 15) ? 0 : j + 1;
    st[{{ S_GN }}] = jn;
    if (jn)  // (else the next block's first tile, or this one's next group's: the gate rows' format, ``collect``'s)
        st[{{ S_FMT }}] = jn < na ? fw & 255 : f2;
    const int part = j >= na, o = (part ? j - na : j) * R;
