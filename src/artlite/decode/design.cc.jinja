// (rot: "Rotated inputs") A group's rotation in the main core's GEMV scratch (idle between tiles): u (fp32 [128][4]), its
// bf16 copies b0, b1 (the gathers' layout, kmath.rotate), 2 KB each. 8 channels' input: v [slot 4][8] as bf16 hi, lo;
// w: their 8 bf16 of the rotation object's w' -> u0 = v w ([8][4] fp32) and its copy
{% if SLOTS == 8 %}__attribute__((noinline, minsize)) void{% else %}[[clang::always_inline]] inline void{% endif %} {{ p }}_ru0(aie::vector<bfloat16, 32> vh, aie::vector<bfloat16, 32> vl,
                                                 const bfloat16 *__restrict w, float *__restrict u, bfloat16 *__restrict b)
{
    const aie::vector<bfloat16, 32> wt = aie::transpose(aie::load_v<8>(w).template grow_replicate<32>(), 4, 8);
    const aie::accum<accfloat, 32> a = aie::mac(aie::mul(aie::transpose(vh, 4, 8), wt), aie::transpose(vl, 4, 8), wt);
    aie::store_v(u, a.template to_vector<float>());
    {{ rotf }}_put(b, a.template to_vector<bfloat16>());
}

// The rounds on u (the rotation object at ro), then u -> the staged C objects at o: object j S + s (j = 0, 1; slot s < S)
// holds channels 64 j .. 64 j + 63 of slot s in bf16 (each 8 channels' 4 slots stored: the stores past S land where a
// later j's go, or past the objects{{ "; 8 slots: u holds half h's slots 4 h .. 4 h + 3, half 1 first: half 0's stores
// overwrite the ones half 1's past S left" if SLOTS == 8 else "" }})
__attribute__((noinline{{ ", minsize" if SLOTS == 8 else "" }})) void {{ p }}_rrun(const uint8_t *__restrict ro, uint8_t *__restrict scr, bfloat16 *__restrict o, int S{{ ", int h" if SLOTS == 8 else "" }})
{
