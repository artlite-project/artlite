    for (int s = 0; s < S; s++) {
        float *__restrict w = gw + 64 * s;
        aie::vector<float, 32> y = aie::concat(aie::load_v<8>(yt + 8 * s), aie::load_v<8>(yt + {{ 8 * SLOTS }} + 8 * s),
{% if wide %}
                                               aie::load_v<8>(yt + {{ 16 * SLOTS }} + 8 * s), aie::load_v<8>(yt + {{ 24 * SLOTS }} + 8 * s));
{% else %}
                                               aie::zeros<float, 8>(), aie::zeros<float, 8>());
{% endif %}
        y = aie::select(aie::zeros<float, 32>(), y, mk);  // (the tile's valid rows; its padding rows' are zero anyway)
        if (!part) {
            aie::store_v(tb + 16, y);
