{% endif %}
{% else %}
    int add = 0;
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < S; s++) {
        add = {{ p }}_slot(ws, s, flags, fw, nv0, row0 + r0, n, 0);
        if (nv1 > 0)
            add += {{ p }}_slot(ws, s, flags, fw, nv1, row0 + r0 + 16, n + add, 1);
    }
{% if tail_pairs %}
    {{ p }}_ynext(yt, r, pf);
{% else %}
    AIE_LOOP_UNROLL_FULL  // (zv's rolled loop: ~10 cycles a store, on every row tile)
    for (int i = 0; i < {{ YT }}; i += 16)
        aie::store_v(yt + i, aie::zeros<float, 16>());
{% endif %}
{% endif %}
{% else %}
    if (flags & {{ F_GU }})
{% if split %}
        nv = (fw & {{ B_SPLIT }}) ? {{ p }}_gusplit(ws, S, R, fw) : {{ p }}_guwin(ws, S, R);
{% elif gu_win %}
        nv = {{ p }}_guwin(ws, S, R);
{% elif qtails %}
        nv = 8 * nw;
{% else %}
        nv = 8;
{% endif %}
{% if SLOTS == 8 %}
    const int add = {{ p }}_slots(ws, S, flags, fw, nv, row0 + r0, n, hres);
{% if tail_pairs %}
    {{ p }}_ynext(yt, r, pf);
{% else %}
    AIE_LOOP_UNROLL_FULL
    for (int i = 0; i < {{ YT }}; i += 32)
        aie::store_v(yt + i, aie::zeros<float, 32>());
{% endif %}
{% else %}
    int add = 0;
    AIE_LOOP_NO_UNROLL
{% if rg %}
    for (int s = 0; s < S; s++) {  // (per row group: its R rows of the tile's block j)
        int a = 0;
        AIE_LOOP_NO_UNROLL
        for (int j = 0; j < G; j++) {
{% if qtails %}
            const int k = (flags & {{ F_GU }}) ? (j < nw ? 8 : 0) : (nv - R * j > R ? R : nv - R * j);  // (gate / up: a window's 8)
{% else %}
            const int k = nv - R * j > R ? R : nv - R * j;
{% endif %}
            if (k > 0)
                a += {{ p }}_slot(ws, s, flags, fw, k, row0 + r0 + R * j, n + a, j);
        }
        add = a;
    }
{% else %}
    for (int s = 0; s < S; s++)
        add = {{ p }}_slot(ws, s, flags, fw, nv, row0 + r0, n);
{% endif %}
{% if tail_pairs %}
    {{ p }}_ynext(yt, r, pf);
{% else %}
    AIE_LOOP_UNROLL_FULL
    for (int i = 0; i < {{ YT }}; i += 16)
        aie::store_v(yt + i, aie::zeros<float, 16>());
{% endif %}
{% endif %}
{% endif %}
    st[{{ S_STG }}] = n + add;
    if (n + add >= {{ C_LEN }}{{ " && !(flags & %d)" % F_HOUT if moe else "" }})
        st[(flags & {{ F_MSG }}) ? {{ S_NM }} : {{ S_NE }}] = S;
    if (tl == 0)
