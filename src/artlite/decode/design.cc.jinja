    for (int i = 0; i < {{ SLOTS }}; i++) {  // (the staging moves down, zero behind)
        aie::store_v(stg + {{ 2 * C_LEN }} * i, aie::load_v<64>(stg + {{ 2 * C_LEN }} * i + {{ C_LEN }}));
        aie::store_v(stg + {{ 2 * C_LEN }} * i + {{ C_LEN }}, aie::zeros<bfloat16, 64>());
    }
