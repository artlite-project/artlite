{% endif %}
            return;
        }
        if (st[{{ S_ESRC }}] == 5) {  // 5: the routing's objects (S_NS 1)
            aie::store_v(c, aie::load_v<64>(WS(bfloat16, {{ w_.rbuf }}) + {{ C_LEN }} * j));
            return;
        }
{% endif %}
{% if SLOTS == 8 %}
        // (the next input's x, [k block][slot SP][8]: a column's whole rows in DDR, not 16 bytes of a slot at a time)
        const int ls = {{ p }}_lsp(S), q = (64 >> ls) * j;
        st[{{ S_EJ }}] = j + 1;
        const float *__restrict pa = WS(float, {{ w_.res }}) + q;
        if (ls == 0) {
            aie::store_v(c, aie::accum<accfloat, 64>(aie::load_v<64>(pa)).template to_vector<bfloat16>());
        } else if (ls == 1) {
            AIE_LOOP_NO_UNROLL
            for (int b = 0; b < 32; b += 8) {
                const aie::vector<float, 32> v = aie::concat(aie::load_v<8>(pa + b), aie::load_v<8>(pa + {{ RES_PITCH }} + b),
                                                             aie::load_v<8>(pa + b + 8), aie::load_v<8>(pa + {{ RES_PITCH }} + b + 8));
                aie::store_v(c + 2 * b, aie::accum<accfloat, 32>(v).template to_vector<bfloat16>());
                b += 8;
            }
        } else {
            {{ p }}_rows4(pa, c);
            {{ p }}_rows4(ls == 2 ? pa + 8 : hres + q, c + 32);
        }
{% else %}
        const float *__restrict pr = WS(float, {{ w_.res }}) + {{ RES_PITCH }} * s + {{ C_LEN }} * j;
        aie::store_v(c, aie::accum<accfloat, 64>(aie::load_v<64>(pr)).template to_vector<bfloat16>());
{% endif %}
        return;
    }
{% endif %}
    bfloat16 *__restrict stg = WS(bfloat16, {{ w_.stg }});
    aie::store_v(c, aie::load_v<64>(stg + {{ 2 * C_LEN }} * s));
    if (!last)
        return;
    for (int i = 0; i < {{ SLOTS }}; i++) {  // (the staging moves down, zero behind)
        aie::store_v(stg + {{ 2 * C_LEN }} * i, aie::load_v<64>(stg + {{ 2 * C_LEN }} * i + {{ C_LEN }}));
        aie::store_v(stg + {{ 2 * C_LEN }} * i + {{ C_LEN }}, aie::zeros<bfloat16, 64>());
    }
    st[{{ S_STG }}] -= {{ C_LEN }};
}

{% if rot %}
// (rot) F_PSQ: the partial sums object (the 8 columns' C objects at 128 c: [slot 4][8 lanes] fp32 squares of their
// residual slices{{ "; 8 slots: two a column, of slots 0 .. 3 and 4 .. 7, at 256 c" if SLOTS == 8 else "" }}) -> the slots' 1 / rms
// (8 lanes per slot)
__attribute__((minsize)) void {{ p }}_psq(const bfloat16 *__restrict x, int32_t *__restrict ws)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const float *__restrict q = (const float *)(x + {{ 2 * META }});
{% if SLOTS == 8 %}
    aie::vector<float, 32> sq = aie::load_v<32>(q), sq1 = aie::load_v<32>(q + 32);
    AIE_LOOP_NO_UNROLL
    for (int c = 1; c < {{ COLS }}; c++) {
        sq = aie::add(sq, aie::load_v<32>(q + 64 * c));
        sq1 = aie::add(sq1, aie::load_v<32>(q + 64 * c + 32));
    }
    const aie::vector<float, 16> iv = al::inv_rms<{{ H }}, 8>(al::group8<false>(aie::concat(sq, sq1)).template grow<16>(), {{ eps }}f);
    aie::store_v(WS(float, {{ w_.inv }}), al::rows4(iv));
    aie::store_v(WS(float, {{ w_.inv }}) + 32, al::rows4(aie::shuffle_down(iv, 4)));
}
{% else %}
    aie::vector<float, 32> sq = aie::load_v<32>(q);
    AIE_LOOP_NO_UNROLL
    for (int c = 1; c < {{ COLS }}; c++)
        sq = aie::add(sq, aie::load_v<32>(q + 32 * c));
    const aie::vector<float, 8> ss = al::group8<false>(aie::concat(sq, aie::zeros<float, 32>()));
    aie::store_v(WS(float, {{ w_.inv }}), al::rows4(al::inv_rms<{{ H }}, {{ SLOTS }}>(ss.template grow<16>(), {{ eps }}f)));
}
{% endif %}

// (rot) The rotations run on the helper (the main core's commands: their objects and its workspace as the helper sees
// them; the helper's ``htask`` runs psq, rote, rotx{{ "; hrot: a gate / up's last tile, ``cmd``" if moe else "" }}): the main
// core's program memory
__attribute__((minsize)) void {{ p }}_cpsq(const bfloat16 *__restrict x, int32_t *__restrict ws, int32_t *__restrict cmd)
{
    cmd[1] = (int32_t)(uintptr_t)x + ({{ SHM }});
    cmd[2] = (int32_t)(uintptr_t)ws + ({{ SHM }});
    cmd[{{ C_KIND }}] = {{ K_PSQ }};
}

__attribute__((minsize)) void {{ p }}_crote(const uint8_t *__restrict a, int32_t *__restrict ws, int32_t *__restrict cmd)
