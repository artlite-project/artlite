    }
{% elif gu_win %}
    {{ p }}_rows(ws, flags & ~{{ F_GU }}, {{ YB }} * G);
    const int nw = gu ? {{ p }}_guwin(ws, S, R) : 0;  // (gate / up: 8 outputs once the window completes, else none)
{% else %}
    {{ p }}_rows(ws, flags | gu, {{ YB }} * G);
{% endif %}
{% if not wide and not qtails %}
    int add = 0;
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < S; s++) {  // (per block of 16 rows: R rows of a row group, or a tile's rows; F_GU: 8 outputs)
        int a = 0;
        float *__restrict as = (float *)((uint8_t *)aw + {{ ACC_AT }}) + {{ H }} * s;
        AIE_LOOP_NO_UNROLL
        for (int j = 0; j < G; j++) {  // (a gate / up tile: one row group)
            const int k = gu ? {{ "nw" if gu_win else 8 }} : (nv - R * j > R ? R : nv - R * j);
            if (k > 0)
                a += {{ p }}_slot(ws, s, flags, fw, k, row0 + r0 + R * j, n + a, j, as);
        }
        add = a;
    }
{% endif %}
    AIE_LOOP_NO_UNROLL
    for (int b = 0; b < G; b++)  // (the tile's row blocks; the others are zero)
        AIE_LOOP_UNROLL_FULL
        for (int i = 0; i < {{ YB }}; i += 16)
