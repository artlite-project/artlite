            aie::store_v(yt + h, al::mulc<32>(aie::load_v<32>(yt + h + 64), aie::load_v<32>(gs + 64)).template to_vector<float>());
            aie::store_v(yt + h + 32, al::mulc<32>(aie::load_v<32>(yt + h + 96), aie::load_v<32>(gs + 96)).template to_vector<float>());
