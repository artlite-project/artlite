    else
        {{ p }}_rows(ws, flags, {{ YB }} * G);
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < S && !(flags & {{ F_ACCUM }}); s++) {
        int a = 0;
        AIE_LOOP_NO_UNROLL
        for (int j = 0; j < G; j++) {
            const int k = nv - R * j > R ? R : nv - R * j;
