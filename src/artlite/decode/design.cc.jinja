    const int k = {{ split_rows }} - o < R ? {{ split_rows }} - o : R;
    const aie::mask<32> mk = aie::mask<32>::from_uint32(k >= 32 ? ~0u : (1u << k) - 1u);
{% if SLOTS == 8 %}
    volatile int32_t ta[2] = {{ "{%d, %d}" % (ACT8[0], ACT8[1]) }};  // (the helper's copies: the gathers' operands need pointers)
{% endif %}
    aie::store_v(tb, aie::zeros<float, 16>());
    aie::store_v(tb + 48, aie::zeros<float, 16>());
