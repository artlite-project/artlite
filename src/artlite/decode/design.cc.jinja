        // partial sums object counted in M_NX, an R phase's A objects past its rotation objects in M_NT, for the other
        // cores: a padding object, skipped)
        const int n = m[{{ M_RGN }}], per = 16 >> (2 - lper) >> ((flags & {{ F_RACT + F_RPOST + F_RSLOT }}) ? 1 : 0);
        st[{{ S_NWP }}] = (flags & {{ F_RPS }}) ? 1 : 0;
        st[{{ S_NASKIP }}] = st[{{ S_NT }}];
        st[{{ S_NT }}] = 0;
        st[{{ S_TL }}] = 0;
        st[{{ S_NRX }}] = (m[{{ M_NX }}] >> lper) - st[{{ S_NPS }}];
{% else %}
        const int n = m[{{ M_RGN }}], per = 16 >> (2 - lper) >> ((flags & {{ F_RACT }}) ? 1 : 0);
        st[{{ S_NRX }}] = m[{{ M_NX }}] >> lper;
{% endif %}
        st[{{ S_NXP }}] = 0;
        st[{{ S_NNO }}] = 0;
        st[{{ S_NIN }}] = 0;
        st[{{ S_RN }}] = n;
        st[{{ S_NRP }}] = ((n < per ? n : per) + 1) >> 1;
        st[{{ S_NGA }}] = {{ p }}_nga(n < per ? n : per);
    }
{% endif %}
{% if gu_win and moe %}
    int gub = flags & {{ F_GU }};
    for (int i = 0; i < m[{{ M_NB }}]; i++)
        gub |= m[{{ M_B + 1 }} + 3 * i] & {{ B_GU }};
    if (gub) {  // (the slots' gate / up windows: ``guwin``; F_GU or a B_GU block)
        st[{{ S_GN }}] = 0;
        st[{{ S_GK }}] = 0;
        {{ p }}_zv(WS(int32_t, {{ w_.gw }}), {{ (64 if wide else 32) * SLOTS * 4 // 64 }});
    }
{% elif gu_win %}
    if (flags & {{ F_GU }}) {  // (the slots' gate / up windows: ``guwin``)
        st[{{ S_GN }}] = 0;
        st[{{ S_GK }}] = 0;
        {{ p }}_zv(WS(int32_t, {{ w_.gw }}), {{ (64 if wide else 32) * SLOTS * 4 // 64 }});
    }
{% endif %}
    {{ p }}_zv(WS(int32_t, {{ w_.yt }}), {{ YT * 4 // 64 }});
}

// The helper: one command of the main core. K_TILE: the partial rows of its super-blocks -> r; K_STRIP: an input
// object (its x panels into xp, its 16-k sums into the scratch); K_INPUT: the sum panels of every chunk (into the main
// core's xs), the slots' 1 / rms -> r (8 lanes per slot); K_BEGIN: a phase's metadata (hbegin)
void {{ p }}_htask(const int32_t *__restrict cmd, float *__restrict r, uint8_t *__restrict scr, float *__restrict sq,
                   uint8_t *__restrict xp{{ ", float *__restrict hres, const int8_t *__restrict oh" if SLOTS == 8 else "" }}{{ ", float *__restrict ist" if states else "" }}{{ ", int32_t *__restrict hst" if help_flag else "" }})
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const int kind = cmd[{{ C_KIND }}];
{% if help_flag %}
    hst[0] = kind == {{ K_HELP }} ? cmd[1] : 0;  // (the model core's work after this command: K_HELP)
    if (kind == {{ K_HELP }})
        return;
{% endif %}
    if (kind == {{ K_NOP }})
        return;
    if (kind == {{ K_BEGIN }}) {
        {{ p }}_hbegin((const bfloat16 *)(uintptr_t)cmd[0], (int32_t *)(uintptr_t)cmd[1], cmd[2]{{ ", hres" if SLOTS == 8 else "" }}{{ ", ist" if states else "" }});
        return;
    }
{% if rot %}
    if (kind >= {{ K_PSQ }}) {  // (the main core's rotations: ``cpsq`` ..)
        const uint8_t *a = (const uint8_t *)(uintptr_t)cmd[0];
        const bfloat16 *x = (const bfloat16 *)(uintptr_t)cmd[1];
        int32_t *ws = (int32_t *)(uintptr_t)cmd[2];
        if (kind == {{ K_PSQ }})
            {{ p }}_psq(x, ws);
        else if (kind == {{ K_ROTE }})
            {{ p }}_rote(a, ws{{ ", hres" if SLOTS == 8 else "" }});
{% if moe %}
        else if (kind == {{ K_HROT }})
            {{ p }}_hrot(a, ws);
{% endif %}
        else
            {{ p }}_rotx(x, a, ws);
        return;
    }
{% endif %}
{% if moe %}
    if (kind == {{ K_SUB }}) {
        {{ p }}_hsub((int32_t *)(uintptr_t)cmd[1]{{ ", ist" if states else "" }});
        return;
    }
{% if qtails %}
    if (kind == {{ K_QGU }}) {  // (a gate / up group's epilogue: ``hqgu``, the second entry of the page in: the group's
        // tiles' format's, the last tile's; situ's constants resident, a page writes no data: their address passed)
        ((void (*)(const int32_t *, uint8_t *, const float *))(intptr_t)((const volatile int32_t *){{ pg_state }})[2])(
            cmd, scr, {{ ksitu }}_c);
        return;
    }
{% endif %}
    if (kind == {{ K_ACC }}) {
        {{ p }}_hacc((const float *)(uintptr_t)cmd[0], (int32_t *)(uintptr_t)cmd[1], cmd[2]);
        return;
    }
{% endif %}
{% if states %}
    if (kind == {{ K_INK }} || kind == {{ K_IPS }} || kind == {{ K_COEF }} || kind == {{ K_BLEND }}) {
        // (the residual stream's work: ``hink_all``)
{% if ink_page %}
        // (pages of the helper, ``ink_page``: the step's and the mixes' coefficient sets, the blends'; its scratch, idle
        // between the strips' 16-k sums, takes the pager's data reads)
        if (kind == {{ K_BLEND }}) {
            {{ mp }}_pg_need<1>({{ ink_page + 1 }}, scr);
            ((void (*)(const int32_t *, float *, float *))(intptr_t)((const volatile int32_t *){{ pg_state }})[1])(cmd, sq, ist);
            return;
        }
        {{ mp }}_pg_need<1>({{ ink_page }}, scr);
        ((void (*)(const int32_t *, float *, float *, float *))(intptr_t)((const volatile int32_t *){{ pg_state }})[1])(
            cmd, sq, ist, (float *)scr);
{% else %}
        if (kind == {{ K_BLEND }})
            {{ p }}_hmix(cmd, sq, ist);
        else
            {{ p }}_hink_all(cmd, sq, ist, (float *)scr);
{% endif %}
        return;
    }
    if (kind == {{ K_SSTRIP }}) {  // an fp32 state object d: state d % nr of k range d / nr (``post``)
        {{ p }}_Win<4> w_;
        const int d = cmd[2], lnr = cmd[{{ C_NST }}], sp = cmd[{{ C_SP }}], lsp = (sp > 1) + (sp > 2);
        const int b = d & ((1 << lnr) - 1), rg = d >> lnr, n = 8 >> lsp, nr = 1 << lnr;
        if (d == 0)
            aie::store_v(sq, aie::zeros<float, 32>());
        float *acc = (float *)(uintptr_t)cmd[{{ C_ACC }}];
        const int cs = cmd[{{ C_CSET }}];  // (the coefficient set; -1: one state of coefficient 1)
{% if qtails %}
        const int ng = cmd[{{ C_NG }}] - n * rg, nn = ng < n ? ng : n;  // (the range's groups: the last range's what is left)
        {{ p }}_hsacc((const float *)(uintptr_t)cmd[0], cs < 0 ? nullptr : sq + 32 + 32 * cs + 4 * b, acc, b == 0, sp, 128 * sp * nn);
{% else %}
        const int nn = n;
        {{ p }}_hsacc((const float *)(uintptr_t)cmd[0], cs < 0 ? nullptr : sq + 32 + 32 * cs + 4 * b, acc, b == 0, sp);
{% endif %}
        if (b == nr - 1) {  // (the range's sum: its panels, nn 128-k groups)
            {{ p }}_hspan(acc, cmd[1] ? (const bfloat16 *)(uintptr_t)cmd[1] : (const bfloat16 *){{ p }}_ones, cmd[1] ? 16 : 0, sq, xp, (float *)scr,
                          n * rg, nn, sp, cmd[{{ C_XC0 }}]);
        }
        return;
    }
{% endif %}
    if (kind == {{ K_TILE }}) {
        {{ p }}_Win<2> w_;
        al::zero<{{ YN }}, 32>(r);
{% if rowsplit %}
        {{ mp }}_mmv<1>((uint8_t *)(uintptr_t)cmd[0], xp + {{ gv.XP_CHUNK }} * cmd[1] + ({{ p }}_rs(cmd[3]) ? 0 : {{ gv.XP_CHUNK // 2 }}),
                        (const uint8_t *)(uintptr_t)cmd[2], r, scr, cmd[3]);
{% else %}
        {{ mp }}_mmv<1>((uint8_t *)(uintptr_t)cmd[0], xp + {{ "%d + %d" % (gv.XPH, gv.XPHC) if xh else "%d + %d" % (gv.XP_CHUNK // 2, gv.XP_CHUNK) }} * cmd[1],
                        (const uint8_t *)(uintptr_t)cmd[2], r, scr, cmd[3]);
{% endif %}
        return;
    }
    if (kind == {{ K_STRIP }}) {  // input object d
        {{ p }}_Win<4> w_;
{% if "strip" in ablate %}
        return;
{% endif %}
        const int d = cmd[2];
        if (d == 0)
            aie::store_v(sq, aie::zeros<float, 32>());
{% if SLOTS == 8 %}
        if (d == 0)
            aie::store_v(sq + 32, aie::zeros<float, 32>());
{% endif %}
        const bfloat16 *x = (const bfloat16 *)(uintptr_t)cmd[0];
{% if xh and SLOTS == 8 %}
        // (strip d: super-block d & 3 of chunk d / 4, in half (d >> 1) & 1)
        uint8_t *xpk = xp + {{ gv.XPH }} * ((d >> 1) & 1) + {{ gv.XPHC }} * (d >> 2) + {{ 32 * gv.PANEL }} * (d & 1);
{% elif xh %}
        uint8_t *xpk = xp + {{ gv.XPH }} * (d & 1) + {{ gv.XPHC }} * {{ "((d >> 1) + cmd[3])" if moe else "(d >> 1)" }};  // (strip d: half d & 1 of chunk d / 2{{ " + the phase's first" if moe else "" }})
{% else %}
        uint8_t *xpk = xp + {{ gv.PANEL * OBJ_K // 8 }} * d;
{% endif %}
        float *t = (float *)scr + {{ OBJ_K * SLOTS // 16 }} * d;
{% if SLOTS == 8 %}
        const bfloat16 *w = (const bfloat16 *)(uintptr_t)cmd[1];
        const int sp = cmd[{{ C_SP }}];
        if (sp == 8)
            {{ p }}_hstrip<true, true>(x, w ? w : (const bfloat16 *){{ p }}_w1, sq, xpk, t, sp, w ? 16 : 0, oh);
        else if (w)
            {{ p }}_hstrip<true, false>(x, w, sq, xpk, t, sp, 16, oh);
        else
            {{ p }}_hstrip<false, false>(x, nullptr, sq, xpk, t, sp, 0, oh);
{% else %}
        const int sp = {{ "cmd[%d]" % C_SP if packed else 4 }};
{% if norm_objs %}
        if (cmd[1])
            {{ p }}_hstrip<true>(x, (const bfloat16 *)(uintptr_t)cmd[1], sq, xpk, t, sp);
        else
{% endif %}
            {{ p }}_hstrip<false>(x, nullptr, sq, xpk, t, sp);
{% endif %}
        return;
    }
{% if hdr %}
    if (kind == {{ K_PSTRIP }}) {  // a header's input object d
        {{ p }}_Win<4> w_;
{% if "strip" in ablate %}
        return;
{% endif %}
        const int d = cmd[2];
        if (d == 0)
            aie::store_v(sq, aie::zeros<float, 32>());
        const bfloat16 *x = (const bfloat16 *)(uintptr_t)cmd[0], *w = (const bfloat16 *)(uintptr_t)cmd[1];
        const float *ivv = (const float *)(uintptr_t)cmd[3];
        uint8_t *xpk = xp + {{ gv.PANEL * POST_K // 8 }} * d;
        float *t = (float *)scr + {{ POST_K // 4 }} * d;
        bfloat16 *nb = (bfloat16 *)(scr + {{ MAX_K }});  // (past the K group's t)
{% if packed %}
        const int sp = cmd[{{ C_SP }}];
        if (sp == 1)
            {{ p }}_hpstrip<1>(x, w, w + {{ NX_PER_NORM * POST_K }}, ivv, sq, xpk, t, nb);
        else if (sp == 2)
            {{ p }}_hpstrip<2>(x, w, w + {{ NX_PER_NORM * POST_K }}, ivv, sq, xpk, t, nb);
        else if (sp == 2 + {{ C_MIRROR }})
            {{ p }}_hpstrip<2, true>(x, w, w + {{ NX_PER_NORM * POST_K }}, ivv, sq, xpk, t, nb);
        else
{% endif %}
            {{ p }}_hpstrip<4>(x, w, w + {{ NX_PER_NORM * POST_K }}, ivv, sq, xpk, t, nb);
        return;
    }
{% endif %}
{% if tails %}
    if ((cmd[2] >> 5 & {{ gv.NSB - 1 }}) == {{ gv.NSB // 2 }}) {  // (a half chunk at the end: its x panels as the helper's
        // half of the chunk too, ``hinput``)
        const int c = cmd[2] >> {{ 5 + gv.NSB.bit_length() - 1 }};
        {{ p }}_cv((int32_t *)(xp + {{ gv.XPH }} + {{ gv.XPHC }} * c), (const int32_t *)(xp + {{ gv.XPHC }} * c), {{ gv.XPHC // 64 }});
    }
{% elif qtails %}
    if (const int q = cmd[2] >> 5 & {{ gv.NSB - 1 }}) {  // (a tail of q super-blocks at the end, ``Region.qt``: its x panels
        // repeated through the chunk, ``hinput``; the phase's first chunk 0: a states phase's)
        uint8_t *__restrict xc = xp + {{ gv.XPHC }} * (cmd[2] >> {{ 5 + gv.NSB.bit_length() - 1 }});
        AIE_LOOP_NO_UNROLL
        for (int j = q; j < {{ gv.NSB }}; j++) {
            const int i = j & (q - 1);
            {{ p }}_cv((int32_t *)(xc + {{ gv.XPH }} * (j >> 1) + {{ 32 * gv.PANEL }} * (j & 1)),
                       (const int32_t *)(xc + {{ gv.XPH }} * (i >> 1) + {{ 32 * gv.PANEL }} * (i & 1)), {{ 32 * gv.PANEL // 64 }});
        }
    }
{% endif %}
    {{ p }}_hinput((uint8_t *)(uintptr_t)cmd[0], (const float *)scr, sq, r, cmd[2] >> 5, cmd[1]{{ ", __builtin_bit_cast(float, cmd[3])" if post else "" }});
}
{% if moe and route_page %}

// (a page of the helper: the routing, entered through the pager's state words only; external, so that it stays in the
// object for ``paging.link``)
void {{ p }}_pgr_route(const int32_t *__restrict m, int32_t *__restrict ws, int col)
{
    {{ p }}_route(m, ws, col);
}
{% endif %}
{% if qtails and moe %}
{% for g, rs in paged_pages %}

// (the helper's page of {{ g | join(", ") }}: its second entry, a gate / up group's epilogue, ``hqgu`` (of its formats' rows,
// cmd's R); external, as ``pgr_route``; c: situ's constants, which the resident caller names so that they stay in its data)
void {{ p }}_pgq_{{ g | join("_") | lower }}(const int32_t *__restrict cmd, uint8_t *__restrict scr, const float *__restrict c)
{
{% for r in rs[:-1] %}
    if (((cmd[1] >> 8) & 255) == {{ r }}) {
        {{ p }}_hqgu<{{ r }}>(cmd, scr);
        return;
    }
{% endfor %}
    {{ p }}_hqgu<{{ rs[-1] }}>(cmd, scr);
}
{% endfor %}
{% endif %}
{% if ink_page %}

// (pages of the helper: the residual stream's step, ``hink_all``, and the mixes' work, ``hmix``; external, as
// ``pgr_route``)
void {{ p }}_pgr_ink(const int32_t *__restrict cmd, float *__restrict sq, float *__restrict ist, float *__restrict scr)
{
    {{ p }}_hink_all(cmd, sq, ist, scr);
}

void {{ p }}_pgr_mix(const int32_t *__restrict cmd, float *__restrict sq, float *__restrict ist)
{
    {{ p }}_hmix(cmd, sq, ist);
}
{% endif %}

}  // extern "C"
