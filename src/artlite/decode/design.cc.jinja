    const float *__restrict bank = ist + {{ 4 * H8 }} * ({{ INK_STATES }} + 2 * w);
    float *__restrict out = fg + {{ 4 * H8 }} * 2;  // (into the g scratch's place: g is done with; [slot 4][H8])
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < sp; s++) {
        AIE_LOOP_NO_UNROLL
        for (int c = 0; c < {{ H8 }}; c += 32) {
            aie::accum<accfloat, 32> cu = aie::zeros<accfloat, 32>(), ms = aie::zeros<accfloat, 32>();
            AIE_LOOP_NO_UNROLL
            for (int b = 0; b <= n; b++)
                cu = {{ p }}_cmac(cu, ist + {{ 4 * H8 }} * b + {{ H8 }} * s + c, sets[32 * j + 4 * b + s]);
            AIE_LOOP_NO_UNROLL
            for (int b = 0; b < 2; b++)
                ms = {{ p }}_cmac(ms, bank + {{ 4 * H8 }} * b + {{ H8 }} * s + c, sets[32 * m + 4 * b + s]);
            const aie::vector<float, 32> cv = cu.template to_vector<float>(), mv = ms.template to_vector<float>();
            const aie::vector<float, 32> f = aie::load_v<32>(fg + {{ H8 }} * s + c), gn = aie::load_v<32>(fg + {{ 4 * H8 }} + {{ H8 }} * s + c);
            const aie::accum<accfloat, 32> v = aie::add(aie::sub(aie::accum<accfloat, 32>(cv), al::mulff<32>(f, cv)), al::mulff<32>(gn, mv));
            aie::store_v(out + {{ H8 }} * s + c, v.template to_vector<float>());
        }
    }
    {{ p }}_hstage(out, res, sp);
}

// The helper's blend commands: K_BLEND (``post``, ``cmd``: a blend's objects)
__attribute__((noinline)) void {{ p }}_hmix(const int32_t *__restrict cmd, float *__restrict sq, float *__restrict ist)
{
    {{ p }}_hblend((const float *)(uintptr_t)cmd[0], (const bfloat16 *)(uintptr_t)cmd[1], (float *)(uintptr_t)cmd[2], ist,
                   sq + 32, cmd[{{ C_BLEND }}], cmd[3], cmd[{{ C_SP }}]);
}

// The helper's residual-stream commands: K_INK (``cink``: the step), K_IPS (``cips``: the next mix's partial sums
// after cur's slice in res; with M_INKN's nm the message mixes' too, into the scratch scr, which the main core emits
// after the others: its S_IX, S_NE), K_COEF (``ccoef``: a phase's partial sums object -> its coefficient sets)
__attribute__((noinline)) void {{ p }}_hink_all(const int32_t *__restrict cmd, float *__restrict sq, float *__restrict ist,
                                               float *__restrict scr)
{
    const int kind = cmd[{{ C_KIND }}], inkn = cmd[{{ C_INKN }}], sp = cmd[{{ C_SP }}];
    if (kind == {{ K_COEF }})
        {{ p }}_hcoef((const float *)(uintptr_t)cmd[0], sq + 32, cmd[1], cmd[2] & 255, cmd[2] >> 8);
    else if (kind == {{ K_INK }})
        {{ p }}_hink((const float *)(uintptr_t)cmd[0], (const bfloat16 *)(uintptr_t)cmd[1], (float *)(uintptr_t)cmd[2], ist,
                     inkn, sp, cmd[{{ C_PA }}]);
    else if (kind == {{ K_IPS }}) {
        {{ p }}_hips((const float *)(uintptr_t)cmd[1], ist, (float *)(uintptr_t)cmd[2] + {{ H8 }} * sp,
                     (inkn & 15) + ((inkn >> 4) & 1), cmd[3], sp);
        if ((inkn >> 20) & 15) {  // (bank_m's 2 states, the nm queries after the nqb:
            // objects of 3 and 1, after the others out of the scratch)
            const float *__restrict q = (const float *)(uintptr_t)cmd[1] + {{ H8 }} * cmd[3];
            const float *__restrict bk = ist + {{ 4 * H8 }} * ({{ INK_STATES }} + 2 * ((inkn >> 24) & 1));
            {{ p }}_hips(q, bk, scr, 1, 3, sp);
            {{ p }}_hips(q + {{ 3 * H8 }}, bk, scr + 128, 1, 1, sp);
            int32_t *__restrict mst = (int32_t *)((uint8_t *)(uintptr_t)cmd[2] - {{ w_.res }} + {{ w_.st }});
            mst[{{ S_IX }}] = (int32_t)(uintptr_t)scr - 0x30000;  // (as the main core sees its south neighbour's memory)
            mst[{{ S_NE }}] += 8;
        }
    }
}

