    if (nv1 > 0)
        add += {{ p }}_slots(ws, S, flags, fw, nv1, row0 + r0 + 16, n + add, hres, 1);
{% if tail_pairs %}
    {{ p }}_ynext(yt, r, pf);
{% else %}
    AIE_LOOP_UNROLL_FULL
    for (int i = 0; i < {{ YT }}; i += 32)
