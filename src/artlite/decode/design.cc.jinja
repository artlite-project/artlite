// One [8 gate | 8 up] window of a B_QT group of row tiles of R rows (row tile j's rows 0 .. R - 1 in yt block j: g 0
// rows 0 .. 7, g 1 rows 8 ..; yt at slot s): its rows 16 W .. of the group's, in its row tiles' order (a 16-row tile's
// block, a pair of 8-row ones', or 13-row ones' rows across two blocks: ``al::join_rows``) -> g, u
template <int R, int W>
[[clang::always_inline]] inline void {{ p }}_qgw(const float *__restrict yt, float *__restrict g, float *__restrict u)
{
    if constexpr (R == 16) {
        aie::store_v(g, aie::load_v<8>(yt + {{ YB }} * W));
        aie::store_v(u, aie::load_v<8>(yt + {{ YB }} * W + 32));
    } else if constexpr (R == 8) {
        aie::store_v(g, aie::load_v<8>(yt + {{ 2 * YB }} * W));
        aie::store_v(u, aie::load_v<8>(yt + {{ 2 * YB }} * W + {{ YB }}));
    } else {
        constexpr int J = 16 * W / R, A = 16 * W % R;  // (the window's first row: row A of row tile J)
        const float *__restrict b = yt + {{ YB }} * J, *__restrict c = b + {{ YB }};
        const aie::vector<float, 16> v = al::join_rows<R, A>(aie::concat(aie::load_v<8>(b), aie::load_v<8>(b + 32)),
                                                             aie::concat(aie::load_v<8>(c), aie::load_v<8>(c + 32)));
        aie::store_v(g, v.template extract<8>(0));
        aie::store_v(u, v.template extract<8>(1));
    }
}

