}

// The next C (or M) object: slot e's first C_LEN staged values (after the last slot: the staging moves down), or
// the residual's next object of a slot
__attribute__((minsize)) void {{ p }}_emit(int32_t *__restrict ws, bfloat16 *__restrict c{{ ", const int32_t *__restrict aw" if moe else "" }}{{ ", float *__restrict hres" if SLOTS == 8 else "" }})
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    int32_t *__restrict st = WS(int32_t, {{ w_.st }});
{% if states %}
    if (st[{{ S_ESRC }}] >= 8) {  // (F_INK) 8: the history window (row r < 3: the X object's, then res's), 9: the staging
        const int r = st[{{ S_ESLOT }}], j = st[{{ S_EJ }}];
        const float *__restrict src;
        if (st[{{ S_ESRC }}] == 9) {  // (past cur's slice and the partial sums: the slice again, the bank's copy; then the
            // message mixes' sums in the helper's scratch, S_IX)
            const int n0 = {{ H8 // 32 }} * st[{{ S_SP }}] + 4, nb = (st[{{ S_INKN }}] >> 16) & 1 ? n0 - 4 : 0;
            src = j < n0 + nb ? WS(float, {{ w_.res }}) + 32 * (j < n0 ? j : j - n0) : (const float *)(uintptr_t)st[{{ S_IX }}] + 32 * (j - n0 - nb);
            st[{{ S_EJ }}] = j + 1;
        } else {
            src = r < 3 ? (const float *)(uintptr_t)st[{{ S_IX }}] + {{ H8 }} * r + 32 * j : WS(float, {{ w_.res }}) + {{ RES_PITCH }} * (r - 3 + (st[{{ S_PQ }}] & 255)) + 32 * j;
            const int last = j + 1 == {{ H8 // 32 }};
            st[{{ S_EJ }}] = last ? 0 : j + 1;
            st[{{ S_ESLOT }}] = last ? r + 1 : r;
        }
        aie::store_v((float *)c, aie::load_v<32>(src));
        return;
    }
{% endif %}
{% if moe %}
    // (acc: its counter over slot 4 + object, the 4 objects of 32 rows of a slot's 128 rows j in a row: a combine's object,
    // half j & 1 of column j / 2's slice)
{% if CPARTS == 2 %}
    const int s = st[{{ S_ESLOT }}], S = st[{{ S_NS }}] << (st[{{ S_ESRC }}] == 4 ? 2 : 0);
{% else %}
    // (acc: its counter over slot {{ H8 // 32 }} + object, the {{ H8 // 32 }} objects of 32 rows of a slot's slice of
    // column j in a row: a combine's objects, [column][96] per slot and third)
    const int s = st[{{ S_ESLOT }}], S = st[{{ S_NS }}] * (st[{{ S_ESRC }}] == 4 ? {{ H8 // 32 }} : 1);
{% endif %}
{% else %}
    const int s = st[{{ S_ESLOT }}], S = st[{{ S_NS }}];
{% endif %}
{% if rot %}
    if (st[{{ S_ESRC }}] == 6) {  // (a rotation's staged objects, in a row)
        const int j = st[{{ S_EJ }}];
        st[{{ S_EJ }}] = j + 1;
        aie::store_v(c, aie::load_v<64>(WS(bfloat16, {{ w_.stg }}) + {{ C_LEN }} * j));
        return;
    }
{% endif %}
    const int last = s + 1 == S;
    st[{{ S_ESLOT }}] = last ? 0 : s + 1;
{% if post %}
    const int src = st[{{ S_ESRC }}];
{% if rot %}
    if (src) {  // 1: res, 2: pend then its partial sums, 3: res (a header's update) then back to the staging, 7: res then its
        // partial sums (an R phase's: ``wpupd``)
{% else %}
    if (src) {  // 1: res, 2: pend then its partial sums, 3: res (a header's update) then back to the staging
{% endif %}
        const int j = st[{{ S_EJ }}], h8 = st[{{ S_H8 }}], nobj = (h8 + {{ C_LEN - 1 }}) >> {{ C_LEN.bit_length() - 1 }};
        if (j == nobj) {  // (src 2) the column's sums of squares of v: [slot 4][8 lanes] fp32{{ " (src 7: of res)" if rot else "" }}
{% if rot %}
            const float *__restrict pv = WS(float, {{ w_.pend }}) - (src == 7 ? {{ (w_.pend - w_.res) // 4 }} : 0);
{% else %}
            const float *__restrict pv = WS(float, {{ w_.pend }});
{% endif %}
            aie::accum<accfloat, 32> sq = aie::zeros<accfloat, 32>();  // (v^2: al::mulff's three products of v, v)
            AIE_LOOP_NO_UNROLL
            for (int k = 0; k < h8; k += 8) {
                const aie::vector<float, 32> v = aie::concat(aie::load_v<8>(pv + k), aie::load_v<8>(pv + {{ RES_PITCH }} + k),
                                                             aie::load_v<8>(pv + {{ 2 * RES_PITCH }} + k), aie::load_v<8>(pv + {{ 3 * RES_PITCH }} + k));
                aie::vector<bfloat16, 32> vh, vl;
                al::split2<32>(v, vh, vl);
                sq = aie::mac(aie::mac(aie::mac_square(sq, vh), vh, vl), vl, vh);
            }
            aie::store_v((float *)c, sq.template to_vector<float>());
            return;
        }
        st[{{ S_EJ }}] = last ? j + 1 : j;
        const float *__restrict pr = WS(float, {{ w_.res }}) + (src == 2 ? {{ w_.pend - w_.res }} / 4 : 0) + {{ RES_PITCH }} * s + {{ C_LEN }} * j;
        aie::store_v(c, aie::accum<accfloat, 64>(aie::load_v<64>(pr)).template to_vector<bfloat16>());
        if (src == 3 && last && j + 1 == nobj)
            st[{{ S_ESRC }}] = 0;
        return;
    }
{% else %}
    if (st[{{ S_ESRC }}]) {
        const int j = st[{{ S_EJ }}];
        st[{{ S_EJ }}] = last ? j + 1 : j;
{% if moe %}
        if (st[{{ S_ESRC }}] == 4) {  // 4: acc (fp32 [slot][H])
{% if CPARTS == 2 %}
            aie::store_v((float *)c, aie::load_v<32>((const float *)((const uint8_t *)aw + {{ ACC_AT }}) + {{ H }} * (s >> 2) + 128 * j + 32 * (s & 3)));
{% else %}
