{% elif qtails %}
    {{ p }}_rows(ws, flags & ~{{ F_GU }}, {{ YB }} * G);  // (a dense gate / up group: its windows after it, ``qguw``)
    const int nw = (flags & {{ F_GU }}) ? {{ p }}_qguw(ws, qm ? qm : G, R) : 0;
{% else %}
    {{ p }}_rows(ws, {{ "flags & ~%d" % F_GU if gu_win else "flags" }}{{ ", 2" if gwin else "" }}{{ ", %d * G" % YB if rg else "" }}{{ ", row0 + r0" if pli and rot else "" }});
{% endif %}
{% if moe %}
{% elif wide %}
    int nv0 = nv > 16 ? 16 : nv, nv1 = nv - nv0;  // (the tile's rows 0 .. 15, 16 .. 31)
{% if gu_win %}
{% if split %}
    if ((flags & {{ F_GU }}) && (fw & {{ B_SPLIT }})) {  // (a split block's tile: its up rows' outputs)
