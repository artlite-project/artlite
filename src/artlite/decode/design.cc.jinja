// The helper: an input's sum panels (nsb super-blocks: T16 at t) -> xs; with norm the slots' 1 / rms -> r (8 lanes
// per slot)
__attribute__((noinline)) void {{ p }}_hinput(uint8_t *__restrict xs, const float *__restrict t, const float *__restrict sq,
                                              float *__restrict r, int nsb, int norm{{ ", float ih" if post else "" }})
{
    aie::set_rounding(aie::rounding_mode::conv_even);
{% if tails %}
    // (an input that ends half a chunk into its last chunk, ``decode.image.Region.half``: that chunk's second half of
    // super-blocks as its first, the tail tiles' second halves on the helper)
    const int nh = (nsb & {{ gv.NSB - 1 }}) == {{ gv.NSB // 2 }} ? {{ gv.NSB // 2 }} : 0;
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < nsb + nh; s++)  // (super-block s: chunk s / {{ gv.NSB }})
        {{ p }}_xs_sb(t + {{ 16 * SLOTS }} * (s < nsb ? s : s - nh), xs + {{ gv.XS_CHUNK }} * (s >> {{ gv.NSB.bit_length() - 1 }}),
                      s & {{ gv.NSB - 1 }});
{% elif qtails %}
    // (an input that ends a tail of q super-blocks into its last chunk, ``decode.image.Region.qt``: the tail repeated
    // through the chunk, the tail tiles' row groups)
    const int q = nsb & {{ gv.NSB - 1 }}, n = q ? (nsb | {{ gv.NSB - 1 }}) + 1 : nsb;
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < n; s++) {  // (super-block s: chunk s / {{ gv.NSB }})
        const int j = s & {{ gv.NSB - 1 }};
        {{ p }}_xs_sb(t + {{ 16 * SLOTS }} * (s < nsb ? s : s - j + (j & (q - 1))), xs + {{ gv.XS_CHUNK }} * (s >> {{ gv.NSB.bit_length() - 1 }}), j);
    }
{% else %}
    AIE_LOOP_NO_UNROLL
    for (int s = 0; s < nsb; s++)  // (super-block s: chunk s / {{ gv.NSB }})
        {{ p }}_xs_sb(t + {{ 16 * SLOTS }} * s, xs + {{ gv.XS_CHUNK }} * (s >> {{ gv.NSB.bit_length() - 1 }}), s & {{ gv.NSB - 1 }});
{% endif %}
    if (!norm)
        return;
{% if SLOTS == 8 %}
    const aie::vector<float, 8> ss = al::group8<false>(aie::load_v<64>(sq));
    aie::store_v(r, al::bcast8(al::inv_rms<{{ H }}, 8>(ss.template grow<16>(), {{ eps }}f).template extract<8>(0)));
{% else %}
    const aie::vector<float, 8> ss = al::group8<false>(aie::concat(aie::load_v<32>(sq), aie::zeros<float, 32>()));
{% endif %}
{% if SLOTS == 8 %}
{% elif post %}
    aie::store_v(r, al::rows4(al::inv_rms<{{ SLOTS }}>(ss.template grow<16>(), ih, {{ eps }}f)));
{% else %}
    aie::store_v(r, al::rows4(al::inv_rms<{{ H }}, {{ SLOTS }}>(ss.template grow<16>(), {{ eps }}f)));
{% endif %}
}

