{% endif %}
{% if pli %}
    if (flags & {{ F_PLI }}) {  // (pli [g][slot][r] bf16{{ "; the tile's from its first row q on" if rot else "" }})
        const bfloat16 *__restrict pl = WS(bfloat16, {{ w_.pli }}){{ " + 4 * q" if rot else "" }};
        AIE_LOOP_NO_UNROLL
