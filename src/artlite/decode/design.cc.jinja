// the groups of the next rotation object after group g of n (pairs of the phase's groups; F_ROTX: of an X object)
[[clang::always_inline]] inline int {{ p }}_nga(int left)
{
    return left > 1 ? 2 : left;
}

// (rot) F_ROTE: the next group of the residual's rotated copies (st[S_RG]: copy S_RC, its group q of the column's slice),
// its rotation object group S_RG & 1 of the A object a: the copy's partial sums object first (the slots' squares of the
// slice, fp32 exact: [slot 4][8 lanes]{{ "; 8 slots: slots 0 .. 3's, then 4 .. 7's (hres)" if SLOTS == 8 else "" }}), then the group's C objects (staged: S_ESRC 6)
