// ---- Q4_K (16 rows), word-major: header [word 16][row 16][4 B], a row's words 0 .. 3 sc lo nibbles, 4 .. 7 mn lo, 8 .. 9
// sc crumbs, 10 .. 11 mn crumbs, 12 .. 13 d 4 x bf16, 14 .. 15 -dmin 4 x bf16 (groups 8 sb + i; crumb nibble n =
// c(group n) + 4 c(group n + 16)); codes [sb][i 8][s 4][row 16][4 B], a row's word (s, i) its 8 consecutive k (k = 256
// sb + 32 i + 8 s + j). A word's 32 B of rows 8 g .. are row group g's panel (8 rows x 8 k): no transposes. Scratch
// (from 1 KB on): tab [sb'][g][hl][i][r] (1 KB) | c [sb'][i][g][{{ L }}] ({{ L // 16 }} KB)

// Pass 1: per (g, sb) the table TD = d sc ([i][r], sc = lo + 16 crumb through I) -> tab; y[g] += the offsets
// hilo(XS sc) 8 d + hilo(XS mn) (-dmin) (w = d sc (q - 8) + 8 d sc - dmin mn). HI: the second core's super-blocks 2, 3
// (crumbs in bits 2-3){{ "; ys: the second super-block's rows at y + ys (row groups)" if rg else "" }}
{% if slots == 8 %}
template <int HI>
__attribute__((noinline)) void {{ p }}_q4k_tab(const uint8_t *__restrict a, const uint8_t *__restrict xs,
                                               bfloat16 *__restrict tab, float *__restrict y)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const v64bfp16ebs8 I = al::eye();
    const v64uint8 msk = broadcast_to_v64uint8((unsigned char)(HI ? 12 : 3));
    AIE_LOOP_NO_UNROLL
    for (int t = 0; t < 4; t++) {  // (g, u) = (t / 2, t % 2), sb = 2 HI + u: its sums' hi and lo panels (no 64-lane values
        // across iterations: the unrolled form spills, a 1.6 KB frame)
        const int g = t >> 1, u = t & 1;
        const uint8_t *hw = a + 32 * g;  // (word w's panel of the rows 8 g ..: at 64 w)
        al::BIn<> xsp((const bfp16ebs8 *)(xs + {{ XS_SLOT }} * HI));
        if (u) {
            xsp.pop();
            xsp.pop();
        }
        const v64bfp16ebs8 X = xsp.pop(), XL = xsp.pop();
        // d, -dmin of the pair: words 12 + HI, 14 + HI ([row][sb % 2] bf16)
        const aie::vector<bfloat16, 16> dp = aie::load_v<16>((const bfloat16 *)(hw + 64 * (12 + HI)));
        const aie::vector<bfloat16, 16> mp = aie::load_v<16>((const bfloat16 *)(hw + 64 * (14 + HI)));
        v64bfp16ebs8 Sl, Sc, Ml, Mc;
        Sl.exponent = Ml.exponent = al::e8(0x85);
        Sc.exponent = Mc.exponent = al::e8(HI ? 0x87 : 0x89);
        Sl.mantissa = (v64int8)unpack(*(const v64uint4 *)(hw + 64 * (2 * HI + u)));
        Ml.mantissa = (v64int8)unpack(*(const v64uint4 *)(hw + 64 * (4 + 2 * HI + u)));
        Sc.mantissa = (v64int8)band(unpack(*(const v64uint4 *)(hw + 64 * (8 + u))), msk);
        Mc.mantissa = (v64int8)band(unpack(*(const v64uint4 *)(hw + 64 * (10 + u))), msk);
        const aie::vector<bfloat16, 8> d8 = u ? aie::filter_odd(dp, 1) : aie::filter_even(dp, 1);
        const aie::vector<bfloat16, 8> m8 = u ? aie::filter_odd(mp, 1) : aie::filter_even(mp, 1);
        const aie::vector<bfloat16, 64> D = d8.template grow_replicate<64>();
        {{ p }}_td(mac_8x8_8x8T(I, 1, Sc, 0, mul_8x8_8x8T(I, 1, Sl, 0)), D, tab + 256 * u + 128 * g);
        aie::accum<accfloat, 64> Y = {{ p }}_mo(mac_8x8_8x8T(XL, 1, Sc, 0, mac_8x8_8x8T(XL, 1, Sl, 0, mac_8x8_8x8T(X, 1, Sc, 0, mul_8x8_8x8T(X, 1, Sl, 0)))),
                                                aie::mul(D, aie::broadcast<bfloat16, 64>(8.0f)).template to_vector<bfloat16>(),
                                                aie::zeros<accfloat, 64>());
        Y = {{ p }}_mo(mac_8x8_8x8T(XL, 1, Mc, 0, mac_8x8_8x8T(XL, 1, Ml, 0, mac_8x8_8x8T(X, 1, Mc, 0, mul_8x8_8x8T(X, 1, Ml, 0)))),
                       m8.template grow_replicate<64>(), Y);
        {{ p }}_yadd8(y + 64 * g, Y);
    }
}

{% else %}
template <int HI>
__attribute__((noinline)) void {{ p }}_q4k_tab(const uint8_t *__restrict a, const uint8_t *__restrict xs,
                                               bfloat16 *__restrict tab, float *__restrict y{{ ", int ys" if rg else "" }})
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const v64bfp16ebs8 I = al::eye();
    const v64uint8 msk = broadcast_to_v64uint8((unsigned char)(HI ? 12 : 3));
    al::BIn<> xsp((const bfp16ebs8 *)(xs + {{ XS_SLOT }} * HI));
    const v64bfp16ebs8 X0 = xsp.pop(), X1 = xsp.pop();
    AIE_LOOP_NO_UNROLL
    for (int g = 0; g < 2; g++) {
        const uint8_t *hw = a + 32 * g;  // (word w's panel of the rows 8 g ..: at 64 w)
        aie::accum<accfloat, 64> Y = aie::zeros<accfloat, 64>();
        // d, -dmin of the pair: words 12 + HI, 14 + HI ([row][sb % 2] bf16)
        const aie::vector<bfloat16, 16> dp = aie::load_v<16>((const bfloat16 *)(hw + 64 * (12 + HI)));
        const aie::vector<bfloat16, 16> mp = aie::load_v<16>((const bfloat16 *)(hw + 64 * (14 + HI)));
        AIE_LOOP_UNROLL_FULL
        for (int u = 0; u < 2; u++) {  // sb = 2 HI + u
            const v64bfp16ebs8 X = u ? X1 : X0;
            v64bfp16ebs8 Sl, Sc, Ml, Mc;
            Sl.exponent = Ml.exponent = al::e8(0x85);
            Sc.exponent = Mc.exponent = al::e8(HI ? 0x87 : 0x89);
            Sl.mantissa = (v64int8)unpack(*(const v64uint4 *)(hw + 64 * (2 * HI + u)));
            Ml.mantissa = (v64int8)unpack(*(const v64uint4 *)(hw + 64 * (4 + 2 * HI + u)));
            Sc.mantissa = (v64int8)band(unpack(*(const v64uint4 *)(hw + 64 * (8 + u))), msk);
            Mc.mantissa = (v64int8)band(unpack(*(const v64uint4 *)(hw + 64 * (10 + u))), msk);
            const aie::vector<bfloat16, 8> d8 = u ? aie::filter_odd(dp, 1) : aie::filter_even(dp, 1);
            const aie::vector<bfloat16, 8> m8 = u ? aie::filter_odd(mp, 1) : aie::filter_even(mp, 1);
            const aie::vector<bfloat16, 64> D = d8.template grow_replicate<64>();
            {{ p }}_td(mac_8x8_8x8T(I, 1, Sc, 0, mul_8x8_8x8T(I, 1, Sl, 0)), D, tab + 256 * u + 128 * g);
            Y = {{ p }}_mo(mac_8x8_8x8T(X, 1, Sc, 0, mul_8x8_8x8T(X, 1, Sl, 0)),
                           aie::mul(D, aie::broadcast<bfloat16, 64>(8.0f)).template to_vector<bfloat16>(), Y);
            Y = {{ p }}_mo(mac_8x8_8x8T(X, 1, Mc, 0, mul_8x8_8x8T(X, 1, Ml, 0)), m8.template grow_replicate<64>(), Y);
{% if rg %}
            {{ p }}_yadd(y + 32 * g + u * ys, Y);  // (each super-block's rows are separate output rows, ys apart)
            Y = aie::zeros<accfloat, 64>();
{% endif %}
        }
{% if not rg %}
        {{ p }}_yadd(y + 32 * g, Y);
{% endif %}
    }
}

{% endif %}
// super-blocks 2 HI, 2 HI + 1 of a Q4_K tile
template <int HI>
__attribute__((noinline)) void {{ p }}_q4k(uint8_t *__restrict a, const uint8_t *__restrict xp,
                                           const uint8_t *__restrict xs, float *__restrict y, uint8_t *__restrict scr{{ ", int ys" if rg else "" }})
{
    bfloat16 *tab = (bfloat16 *)(scr + 1024);
    bfloat16 *c = (bfloat16 *)(scr + 2048);
    {{ p }}_q4k_tab<HI>(a, xs, tab, y{{ ", ys" if rg else "" }});
    {{ p }}_q4k_mm(xp, xs + {{ XS_SLOT }} * HI, a + 1024 + 4096 * HI, c);
    {{ p }}_sc(c, tab, y, 128, 8, {{ 2 * L }});
    {{ p }}_sc(c + {{ 16 * L }}, tab + 256, y{{ " + ys" if rg else "" }}, 128, 8, {{ 2 * L }});
}
