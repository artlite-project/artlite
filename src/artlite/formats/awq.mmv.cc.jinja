// ---- P4_128 (16 rows{{ "; rg: ys, the second super-block's rows at y + ys (row groups)" if rg else "" }}): Q4_K's tile with the AWQ header (formats.awq): [word 16][row 16][4 B], a row's words 0 .. 3 s,
// 4 .. 7 B (the prefill's), 8 .. 11 V hi, 12 .. 15 V lo (V = s (8 - z)), each word the bf16 pair of groups 2 w', 2 w' +
// 1 (128 k each); codes as Q4_K's (mmv/q4kmm). w = s (q - 8) + V. Scratch (from 1 KB on): tab [sb'][g][hl][i][r] (1 KB:
// hi = s, lo = 0) | c [sb'][i][g][{{ L }}] ({{ L // 16 }} KB)

// the 8 rows' bf16 pairs of a header word at p ([r 8][j 2]) -> [r][i 8]: group j's value in its sub-blocks 4 j .. 4 j + 3
[[clang::always_inline]] inline aie::vector<bfloat16, 64> {{ p }}_p4x(const uint8_t *__restrict p)
{
    const aie::vector<bfloat16, 16> v = aie::load_v<16>((const bfloat16 *)p);
    const auto [a, b] = aie::interleave_zip(v, v, 1);
    const aie::vector<bfloat16, 32> c = aie::concat(a, b);
    const auto [d, e] = aie::interleave_zip(c, c, 1);
    return aie::concat(d, e);
}

// Pass 1: per (g, sb) the table (s [i][r], lo 0) -> tab; y[g] += the offsets XS V (V [r][i] = hi + lo words, exact in
// fp32, as bfp16 hi + lo panels against the 32-k sum panels). HI: the second core's super-blocks 2, 3
{% if slots == 8 %}
template <int HI>
__attribute__((noinline)) void {{ p }}_p4_tab(const uint8_t *__restrict a, const uint8_t *__restrict xs,
                                              bfloat16 *__restrict tab, float *__restrict y)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const al::BV nI = al::neg_eye();
    const aie::vector<bfloat16, 64> one = aie::broadcast<bfloat16, 64>(1.0f);
    AIE_LOOP_NO_UNROLL
    for (int t = 0; t < 4; t++) {  // (g, u) = (t / 2, t % 2), sb = 2 HI + u: its sums' hi and lo panels
        const int g = t >> 1, u = t & 1;
        const uint8_t *hw = a + 32 * g + 64 * (2 * HI + u);  // (word w's panel of the rows 8 g ..: at 64 w)
        al::BIn<> xsp((const bfp16ebs8 *)(xs + {{ XS_SLOT }} * HI));
        if (u) {
            xsp.pop();
            xsp.pop();
        }
        const v64bfp16ebs8 X = xsp.pop(), XL = xsp.pop();
        const aie::vector<bfloat16, 64> S = {{ p }}_p4x(hw);
        aie::store_v(tab + 256 * u + 128 * g, aie::transpose(S, 8, 8));
        aie::store_v(tab + 256 * u + 128 * g + 64, aie::zeros<bfloat16, 64>());
        al::BV hi, lo;
        al::split_hilo(aie::mac(aie::mul({{ p }}_p4x(hw + 512), one), {{ p }}_p4x(hw + 768), one), nI, hi, lo);
        const aie::accum<accfloat, 64> Y(mac_8x8_8x8T(XL, 1, lo, 1, mac_8x8_8x8T(XL, 1, hi, 1, mac_8x8_8x8T(X, 1, lo, 1, mul_8x8_8x8T(X, 1, hi, 1)))));
        {{ p }}_yadd8(y + 64 * g, Y);
    }
}

{% else %}
template <int HI>
__attribute__((noinline)) void {{ p }}_p4_tab(const uint8_t *__restrict a, const uint8_t *__restrict xs,
                                              bfloat16 *__restrict tab, float *__restrict y{{ ", int ys" if rg else "" }})
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const al::BV nI = al::neg_eye();
    const aie::vector<bfloat16, 64> one = aie::broadcast<bfloat16, 64>(1.0f);
    al::BIn<> xsp((const bfp16ebs8 *)(xs + {{ XS_SLOT }} * HI));
    const v64bfp16ebs8 X0 = xsp.pop(), X1 = xsp.pop();
    AIE_LOOP_NO_UNROLL
    for (int g = 0; g < 2; g++) {
        aie::accum<accfloat, 64> Y = aie::zeros<accfloat, 64>();
        AIE_LOOP_UNROLL_FULL
        for (int u = 0; u < 2; u++) {  // sb = 2 HI + u
            const uint8_t *hw = a + 32 * g + 64 * (2 * HI + u);  // (word w's panel of the rows 8 g ..: at 64 w)
            const aie::vector<bfloat16, 64> S = {{ p }}_p4x(hw);
            aie::store_v(tab + 256 * u + 128 * g, aie::transpose(S, 8, 8));
            aie::store_v(tab + 256 * u + 128 * g + 64, aie::zeros<bfloat16, 64>());
            al::BV hi, lo;
            al::split_hilo(aie::mac(aie::mul({{ p }}_p4x(hw + 512), one), {{ p }}_p4x(hw + 768), one), nI, hi, lo);
            const v64bfp16ebs8 X = u ? X1 : X0;
            Y = aie::accum<accfloat, 64>(mac_8x8_8x8T(X, 1, lo, 1, mac_8x8_8x8T(X, 1, hi, 1, Y)));
{% if rg %}
            {{ p }}_yadd(y + 32 * g + u * ys, Y);  // (per super-block: its rows of their own with ys)
            Y = aie::zeros<accfloat, 64>();
{% endif %}
        }
{% if not rg %}
        {{ p }}_yadd(y + 32 * g, Y);
{% endif %}
    }
}

{% endif %}
// super-blocks 2 HI, 2 HI + 1 of a P4_128 tile
template <int HI>
__attribute__((noinline)) void {{ p }}_p4(uint8_t *__restrict a, const uint8_t *__restrict xp,
                                          const uint8_t *__restrict xs, float *__restrict y, uint8_t *__restrict scr{{ ", int ys" if rg else "" }})
{
    bfloat16 *tab = (bfloat16 *)(scr + 1024);
    bfloat16 *c = (bfloat16 *)(scr + 2048);
    {{ p }}_p4_tab<HI>(a, xs, tab, y{{ ", ys" if rg else "" }});
    {{ p }}_q4k_mm(xp, xs + {{ XS_SLOT }} * HI, a + 1024 + 4096 * HI, c);
    {{ p }}_sc(c, tab, y, 128, 8, {{ 2 * L }});
    {{ p }}_sc(c + {{ 16 * L }}, tab + 256, y{{ " + ys" if rg else "" }}, 128, 8, {{ 2 * L }});
}
