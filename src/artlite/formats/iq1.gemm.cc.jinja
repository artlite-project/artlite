// k-tile kt -> {{ n_mac }} x 64 bfp16 panels (rows {{ n_mac }} half ..) in the MAC pop order [16-row block][k-step ks][8-row
// half]: on its first call the k-tile's prep, the codes (_iq1g), then the panels (_iqs)
void {{ p }}_dq(const uint8_t *__restrict b, bfloat16 *__restrict ws, uint8_t *__restrict stage,
                int32_t sb, int32_t kt{{ half_arg }}, const uint32_t *__restrict tab_ab, const uint32_t *__restrict tab_cd)
{
{% if "ev_dq" in ablate or "ev_kt" in ablate %}
    event0();
{% endif %}
{% if "dq" in ablate %}
    return;
{% endif %}
{% if halves > 1 %}
    if (half == 0)
        {{ p }}_prep(b, (uint8_t *)ws, kt, tab_ab, tab_cd);
    const int r0 = {{ n_mac }} * half;  // (the half's first row)
{% else %}
    {{ p }}_prep(b, (uint8_t *)ws, kt, tab_ab, tab_cd);
    const int r0 = 0;
{% endif %}
    uint8_t *wsb = (uint8_t *)ws;
    const uint32_t *base = (uintptr_t)tab_ab < (uintptr_t)tab_cd ? tab_ab : tab_cd;  // (every lane at the lower copy)
    {{ p }}_iq1g((const uint16_t *)(wsb + {{ WL }}) + 2 * r0, (const uint32_t *)(wsb + {{ WM }}) + r0, base, base, wsb + {{ WU }});
    {{ p }}_iqs(wsb + {{ WU }}, (const bfloat16 *)(wsb + {{ WS }}) + r0, stage);
{% if "ev_dq" in ablate %}
    event1();
{% endif %}
}
