// ---- Q6_KH: Q6_K's high plane ({{ R2 }} rows, {{ G2 }} row groups; row groups past R: junk), in Q2_K's layout: header words
// [sb][4 words: the int8 sc of sub-blocks 4 w .., a byte each] | [sb] d' = 16 d | codes [sb][word j 16] (the codes' top 2
// bits c: Q2_K's code words), word-major. w ~ d' sc (c - 1.5): per super-block u the scales (_tab), the sub-block sums
// of the codes centered at 2 (Q2_K's _mm), then y += hilo(sum c sc + XS16 sc / 2) d' (_k23sc). Scratch: Q2_K's (hw |
// sct [g 4][j 16][r] | yu [g 4][32] fp32 | dg [g 4][r] | c [j 16][g 4][32])

// Super-block u: its scales sc (I against the rows' bytes: [j][r], exact in bf16) -> sct [g][j][r], d' -> dg, yu[g] =
// XS16 sc / 2 (fp32, the hi and lo rows summed; xs16: the super-block's 16-k sum panels; the half: the scales at half
// their exponent)
__attribute__((noinline)) void {{ p }}_q6h_tab(const uint8_t *__restrict hw, const uint8_t *__restrict xs16,
                                               bfloat16 *__restrict sct, float *__restrict yu, bfloat16 *__restrict dg,
                                               int u)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const v64bfp16ebs8 I = al::eye();
    al::BIn<> xsp((const bfp16ebs8 *)xs16);
{% if slots == 8 %}
    const v64bfp16ebs8 X0 = xsp.pop(), X0l = xsp.pop(), X1 = xsp.pop(), X1l = xsp.pop();
{% else %}
    const v64bfp16ebs8 X0 = xsp.pop(), X1 = xsp.pop();
{% endif %}
    const uint8_t __aie_dm_resource_a *ps = (const uint8_t __aie_dm_resource_a *)(hw + 512 * u);
    const uint8_t __aie_dm_resource_b *pd = (const uint8_t __aie_dm_resource_b *)(hw + 1024 + 128 * u);
    bfloat16 *__restrict pt = sct, *__restrict pg = dg;
    float *__restrict pu = yu;
    v64bfp16ebs8 S0, S1, H0, H1;
    S0.exponent = S1.exponent = al::e8(0x85);
    H0.exponent = H1.exponent = al::e8(0x84);
    AIE_LOOP_NO_UNROLL
    for (int g = 0; g < 4; g++) {
        // (a word's row group: [row 8][4 B]; two words of the rows -> [row][sub-block 8])
        const v16int32 a = concat(*(const v8int32 __aie_dm_resource_a *)ps, *(const v8int32 __aie_dm_resource_a *)(ps + 128));
        const v16int32 b = concat(*(const v8int32 __aie_dm_resource_a *)(ps + 256), *(const v8int32 __aie_dm_resource_a *)(ps + 384));
        ps += 32;
        S0.mantissa = H0.mantissa = (v64int8)shuffle(a, a, T32_2x8);
        S1.mantissa = H1.mantissa = (v64int8)shuffle(b, b, T32_2x8);
        const aie::vector<bfloat16, 16> dm = aie::load_v<16>((const bfloat16 __aie_dm_resource_b *)pd);  // [row 8][d', 0]
        pd += 32;
        aie::store_v(pg, aie::filter_even(dm, 1));
        pg += 8;
        aie::store_v(pt, aie::accum<accfloat, 64>(mul_8x8_8x8T(I, 1, S0, 1)).template to_vector<bfloat16>());
        aie::store_v(pt + 64, aie::accum<accfloat, 64>(mul_8x8_8x8T(I, 1, S1, 1)).template to_vector<bfloat16>());
        pt += 128;
{% if slots == 8 %}
        aie::store_v(pu, aie::accum<accfloat, 64>(
            mac_8x8_8x8T(X1l, 1, H1, 1, mac_8x8_8x8T(X1, 1, H1, 1, mac_8x8_8x8T(X0l, 1, H0, 1, mul_8x8_8x8T(X0, 1, H0, 1)))))
            .template to_vector<float>());
        pu += 64;
{% else %}
        const aie::vector<float, 64> ms = aie::accum<accfloat, 64>(mac_8x8_8x8T(X1, 1, H1, 1, mul_8x8_8x8T(X0, 1, H0, 1))).template to_vector<float>();
        aie::store_v(pu, aie::add(ms.template extract<32>(0), ms.template extract<32>(1)));
        pu += 32;
{% endif %}
    }
}

// super-blocks 2 H, 2 H + 1 of a Q6_KH tile: y[g] (rows 8 g ..) += their rows against xp (their 64 panels)
template <int H>
__attribute__((noinline)) void {{ p }}_q6h(uint8_t *__restrict a, const uint8_t *__restrict xp,
                                           const uint8_t *__restrict xs, float *__restrict y, uint8_t *__restrict scr)
{
{% if slots == 8 %}
    // (8 slots: hw (1280 B) | sct (2304) | yu [g 4][64] (3328) | dg (3392) | zeros [64] (3648) | c [s 8][g 4][64] (7744))
    uint8_t *hw = scr;
    bfloat16 *sct = (bfloat16 *)(scr + 1280), *dg = (bfloat16 *)(scr + 3328), *c = (bfloat16 *)(scr + 3648);
    float *yu = (float *)(scr + 2304), *zy = (float *)(scr + 3392);
    aie::store_v(zy, aie::zeros<float, 64>());
    {{ p }}_k23al(a + {{ 4 * R2 * 8 }} * H, hw, 8, {{ 4 * R2 }});  // (the scales of the two)
    {{ p }}_k23al(a + {{ 4 * R2 * 16 }} + {{ 4 * R2 * 2 }} * H, hw + 1024, 2, {{ 4 * R2 }});  // (d')
    AIE_LOOP_NO_UNROLL
    for (int u = 0; u < 2; u++) {
        {{ p }}_q6h_tab(hw, xs + {{ XS_SLOT }} * (2 + 2 * H + u), sct, yu, dg, u);
        AIE_LOOP_NO_UNROLL
        for (int h = 0; h < 2; h++) {  // (sub-blocks 8 h ..: the offsets with the first half's)
            {{ p }}_q2k_mm8(xp + {{ 32 * PANEL }} * u + {{ 16 * PANEL }} * h,
                            a + {{ 4 * R2 * NW2 }} + {{ 4 * R2 * 16 }} * (2 * H + u) + {{ 4 * R2 * 8 }} * h, c);
            {{ p }}_k23scg<4, 8, 256, 64, 8, 128>(c, sct + 64 * h, h ? zy : yu, h ? 0 : 64, dg, y);
        }
    }
{% else %}
    uint8_t *hw = scr;
    bfloat16 *sct = (bfloat16 *)(scr + 1280), *dg = (bfloat16 *)(scr + 2816), *c = (bfloat16 *)(scr + 2880);
    float *yu = (float *)(scr + 2304);
    {{ p }}_k23al(a + {{ 4 * R2 * 8 }} * H, hw, 8, {{ 4 * R2 }});  // (the scales of the two)
    {{ p }}_k23al(a + {{ 4 * R2 * 16 }} + {{ 4 * R2 * 2 }} * H, hw + 1024, 2, {{ 4 * R2 }});  // (d')
    AIE_LOOP_NO_UNROLL
    for (int u = 0; u < 2; u++) {
        {{ p }}_q6h_tab(hw, xs + {{ XS_SLOT }} * (2 + 2 * H + u), sct, yu, dg, u);
        {{ p }}_q2k_mm(xp + {{ 32 * PANEL }} * u, a + {{ 4 * R2 * NW2 }} + {{ 4 * R2 * 16 }} * (2 * H + u), c);
        {{ p }}_k23sc(c, sct, yu, dg, y);
    }
{% endif %}
}
