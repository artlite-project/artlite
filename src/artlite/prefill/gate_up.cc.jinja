{% from "artlite/gemm/gemm_q.epilogue.cc.jinja" import times_up %}
{% if act == "silu" %}
{% set act_t = km.silu_tanh(walk=(2, 128)) %}
{% else %}
{% set act_t = km.act(km.TABLES[act], table_arg=True, walk=(2, 128)) %}
{% endif %}
{{ act_t.src }}

extern "C" {

// 8 tokens' parts of {{ G }} groups (x: [token 8][group {{ G }}][gate {{ W }} | up {{ W }}] bf16, each part's first 64 the
// group's outputs) -> {{ 8 * G }} panels (8 tokens x 8 outputs) of h = bf16({{ act }}(gate) up) as bfp16ebs8 (the gate / up
// epilogue's of the GEMMs: ``gemm_q.epilogue``'s times_up): the panels' [gate 64 | up 64] gathered into s, the act of the gates
// into y (SiLU: silu_tanh; a GELU form: kmath.act through the table's two copies), then times up
void {{ p }}_act(const bfloat16 *__restrict x, bfloat16 *__restrict s, bfloat16 *__restrict y, bfloat16 *__restrict out,
                 {{ "int32_t zero" if act == "silu" else "const uint32_t *__restrict tab_ab, const uint32_t *__restrict tab_cd" }})
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    bfloat16 *__restrict ps = s;
    AIE_LOOP_NO_UNROLL
    for (int j = 0; j < {{ G }}; j++) {
        AIE_LOOP_UNROLL_FULL
        for (int b = 0; b < 8; b++) {  // (panel 8 j + b: outputs 8 b .. of group j)
            const bfloat16 *__restrict pg = x + {{ 2 * W }} * j + 8 * b;
            aie::store_v(ps, al::gather<8, 8>(pg, {{ 2 * G * W }}));
            aie::store_v(ps + 64, al::gather<8, 8>(pg + {{ W }}, {{ 2 * G * W }}));
            ps += 128;
        }
    }
    {{ act_t }}<{{ 512 * G }}>(s, y, {{ "zero" if act == "silu" else "tab_ab, tab_cd" }});
{{ times_up("s", "y", "out", 8 * G) }}
}

}  // extern "C"
