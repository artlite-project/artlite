// Inkling's residual stream in the prefill (``prefill.ink_stream``).
#define SW(T, off) ((T *)((uint8_t *)ws + (off)))
{% if op == "mix" %}
// The mix core's workspace (bytes): qh, ql [{{ H }}] bf16 (the query's hi and lo parts) | acc [state {{ N }}][ss, dot][16] fp32 |
// cf [16] fp32 (per state its coefficient: lanes 0 .. {{ N - 1 }})
{% set exps = km.exp2(16, prec="fp32") %}
{{ exps.src }}

extern "C" {

// The mix's query (q: [{{ H }}] fp32 as bf16 pairs) -> its hi and lo parts
void {{ p }}_q(const bfloat16 *__restrict q, float *__restrict ws)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const float *__restrict qf = (const float *)q;
    bfloat16 *__restrict qh = SW(bfloat16, {{ w.qh }}), *__restrict ql = SW(bfloat16, {{ w.ql }});
    for (int i = 0; i < {{ H }}; i += 16) {
        aie::vector<bfloat16, 16> h, l;
        al::split2<16>(aie::load_v<16>(qf + i), h, l);
        aie::store_v(qh + i, h);
        aie::store_v(ql + i, l);
    }
}

// Pass A, chunk k of a token's states (x: [state {{ N }}][{{ CH }}] fp32): per state its sum of squares and its dot with the
// query (hi + lo products, three)
void {{ p }}_a(const bfloat16 *__restrict x, float *__restrict ws, int32_t k)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    float *__restrict acc = SW(float, {{ w.acc }});
    if (k == 0)
        al::zero<{{ 32 * N }}, 16>(acc);
    const bfloat16 *__restrict qh = SW(const bfloat16, {{ w.qh }}) + {{ CH }} * k, *__restrict ql = SW(const bfloat16, {{ w.ql }}) + {{ CH }} * k;
    const float *__restrict xf = (const float *)x;
    for (int b = 0; b < {{ N }}; b++) {
        aie::accum<accfloat, 16> ss(aie::load_v<16>(acc + 32 * b)), dt(aie::load_v<16>(acc + 32 * b + 16));
        AIE_LOOP_NO_UNROLL
        for (int i = 0; i < {{ CH }}; i += 16) {
            aie::vector<bfloat16, 16> h, l;
            al::split2<16>(aie::load_v<16>(xf + {{ CH }} * b + i), h, l);
            ss = aie::mac(aie::mac(aie::mac_square(ss, h), aie::add(h, h), l), l, l);
            const aie::vector<bfloat16, 16> a = aie::load_v<16>(qh + i), c = aie::load_v<16>(ql + i);
            dt = aie::mac(aie::mac(aie::mac(dt, h, a), l, a), h, c);
        }
        aie::store_v(acc + 32 * b, ss.template to_vector<float>());
        aie::store_v(acc + 32 * b + 16, dt.template to_vector<float>());
    }
}

// The coefficients: per state b r_b = sqrt(ss_b / {{ H }} + eps), score_b = dot_b / r_b / sqrt({{ H }}) (log2 units), w = softmax(score),
// c_b = w_b / r_b (lane b; the scalar unit has no floating point: every value through vector lanes)
void {{ p }}_c(float *__restrict ws)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const float *__restrict acc = SW(const float, {{ w.acc }});
    aie::vector<float, 16> ss = aie::zeros<float, 16>(), dt = aie::zeros<float, 16>();
    for (int b = 0; b < {{ N }}; b++) {
        ss[b] = aie::reduce_add(aie::load_v<16>(acc + 32 * b));
        dt[b] = aie::reduce_add(aie::load_v<16>(acc + 32 * b + 16));
    }
    const aie::vector<float, 16> ir = al::inv_rms<{{ H }}, {{ N }}>(ss, {{ eps }}f);  // (1 / r_b, lanes past N 0)
    aie::vector<float, 16> sc = al::mulff<16>(al::mulff<16>(dt, ir), aie::broadcast<float, 16>({{ SC }}f));
    float mx = sc[0];
    for (int b = 1; b < {{ N }}; b++)
        mx = aie::max(sc, aie::broadcast<float, 16>(mx))[b];
    aie::vector<float, 16> e = {{ exps }}(aie::sub(sc, aie::broadcast<float, 16>(mx)));
    aie::vector<float, 16> m = aie::zeros<float, 16>();
    for (int b = 0; b < {{ N }}; b++)
        m[b] = e[b];
    aie::vector<float, 16> s = aie::broadcast<float, 16>(aie::reduce_add(m));
    const aie::vector<float, 16> inv = aie::inv(s);
    aie::store_v(SW(float, {{ w.cf }}), al::mulff<16>(al::mulff<16>(m, inv), ir));
}

// Pass B, chunk k: x = sum_b c_b s_b (fp32 products, hi + lo) -> bf16 into the token's row out at {{ CH }} k
void {{ p }}_b(const bfloat16 *__restrict x, float *__restrict ws, bfloat16 *__restrict out, int32_t k)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const float *__restrict xf = (const float *)x;
    const float *__restrict cf = SW(const float, {{ w.cf }});
    AIE_LOOP_NO_UNROLL
    for (int i = 0; i < {{ CH }}; i += 16) {
        aie::vector<float, 16> y = al::mulff<16>(aie::load_v<16>(xf + i), aie::broadcast<float, 16>(cf[0]));
        for (int b = 1; b < {{ N }}; b++)
            y = aie::add(y, al::mulff<16>(aie::load_v<16>(xf + {{ CH }} * b + i), aie::broadcast<float, 16>(cf[b])));
        aie::store_v(out + {{ CH }} * k + i, aie::accum<accfloat, 16>(y).template to_vector<bfloat16>());
    }
}

}  // extern "C"
{% endif %}
{% if op == "resid" %}
// The resid core's workspace (bytes): taps [4][{{ C }}] bf16 | win [row 4][{{ C }}] fp32 (the conv's last 3 inputs and the
// current, row = token % 4) | hl [row 4][hi, lo][{{ C }}] bf16 (the rows as bf16 hi + lo) | snap [3][{{ C }}] fp32 (the inputs of
// the chunk's last 3 valid tokens) | st [16] int32 (token)

namespace {
// A token's conv over 32 channels a step: the current input (wt, fp32) plus the taps' products with the rows of tokens
// t - 3 .. t (r0 .. r3: [hi | lo] bf16 each; inputs bf16 values: their products exact), / sqrt(5){{ "" if BLOCK else ", + cur" }} -> out
__attribute__((noinline)) void {{ p }}_conv(const float *__restrict wt, const bfloat16 *__restrict r0,
                                         const bfloat16 *__restrict r1, const bfloat16 *__restrict r2,
                                         const bfloat16 *__restrict r3, const bfloat16 *__restrict taps,
                                         const float *__restrict cur, float *__restrict out)
{
    for (int j = 0; j < {{ C }}; j += 32) {
        aie::accum<accfloat, 32> a(aie::load_v<32>(wt + j));
        const aie::vector<bfloat16, 32> w0 = aie::load_v<32>(taps + j), w1 = aie::load_v<32>(taps + {{ C }} + j);
        const aie::vector<bfloat16, 32> w2 = aie::load_v<32>(taps + {{ 2 * C }} + j), w3 = aie::load_v<32>(taps + {{ 3 * C }} + j);
        a = aie::mac(aie::mac(a, aie::load_v<32>(r0 + j), w0), aie::load_v<32>(r0 + {{ C }} + j), w0);
        a = aie::mac(aie::mac(a, aie::load_v<32>(r1 + j), w1), aie::load_v<32>(r1 + {{ C }} + j), w1);
        a = aie::mac(aie::mac(a, aie::load_v<32>(r2 + j), w2), aie::load_v<32>(r2 + {{ C }} + j), w2);
        a = aie::mac(aie::mac(a, aie::load_v<32>(r3 + j), w3), aie::load_v<32>(r3 + {{ C }} + j), w3);
        aie::vector<float, 32> y = al::mulff<32>(a.template to_vector<float>(), aie::broadcast<float, 32>({{ SC }}f));
{% if not BLOCK %}
        y = aie::add(y, aie::load_v<32>(cur + j));
{% endif %}
        aie::store_v(out + j, y);
    }
}
}  // namespace

extern "C" {

// The chunk's constants (b: the column's taps [4][{{ C }}] bf16, then the conv's inputs of the 3 positions before the chunk
// [3][{{ C }}] fp32 as bf16 pairs: rows 1 .. 3, also as bf16 hi + lo)
void {{ p }}_prm(const bfloat16 *__restrict b, float *__restrict ws)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    al::copy<{{ 4 * C }}, 16>(SW(bfloat16, {{ w.taps }}), b);
    float *__restrict win = SW(float, {{ w.win }});
    bfloat16 *__restrict hl = SW(bfloat16, {{ w.hl }});
    for (int r = 0; r < 3; r++) {  // (positions p0 - 3 .. p0 - 1: rows 1 .. 3 of token -4 .. -1's ring)
        const float *__restrict h = (const float *)(b + {{ 4 * C }}) + {{ C }} * r;
        al::copy<{{ C }}, 16>(win + {{ C }} * (r + 1), h);
        for (int j = 0; j < {{ C }}; j += 32) {
            aie::vector<bfloat16, 32> hi, lo;
            al::split2<32>(aie::load_v<32>(h + j), hi, lo);
            aie::store_v(hl + {{ 2 * C }} * (r + 1) + j, hi);
            aie::store_v(hl + {{ 2 * C }} * (r + 1) + {{ C }} + j, lo);
        }
    }
    SW(int32_t, {{ w.st }})[0] = 0;
}

// {{ TB }} tokens (x: their conv inputs [{{ TB }}][{{ C }}] bf16{{ ", then cur [" ~ TB ~ "][" ~ C ~ "] fp32" if not BLOCK else "" }}) -> cur' (out: [{{ TB }}][{{ C }}] fp32):
// conv = (y_t + sum_k taps_k y_(t - 3 + k)) / sqrt(5), cur' = {{ "conv (a block's restart)" if BLOCK else "cur + conv" }}; the inputs of the last 3 valid tokens
// (n) kept
void {{ p }}_run(const bfloat16 *__restrict x, float *__restrict ws, float *__restrict out, int32_t n)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    int32_t *__restrict st = SW(int32_t, {{ w.st }});
    const bfloat16 *__restrict taps = SW(const bfloat16, {{ w.taps }});
    float *__restrict win = SW(float, {{ w.win }});
    bfloat16 *__restrict hl = SW(bfloat16, {{ w.hl }});
{% if not BLOCK %}
    const float *__restrict cur = (const float *)(x + {{ TB * C }});
{% endif %}
    for (int i = 0; i < {{ TB }}; i++) {
        const int t = st[0] + i;
        float *__restrict wt = win + {{ C }} * (t & 3);
        bfloat16 *__restrict ht = hl + {{ 2 * C }} * (t & 3);
        for (int j = 0; j < {{ C }}; j += 32) {  // (the input: fp32, and as hi + lo: itself, zero)
            const aie::vector<bfloat16, 32> v = aie::load_v<32>(x + {{ C }} * i + j);
            aie::store_v(wt + j, aie::accum<accfloat, 32>(v).template to_vector<float>());
            aie::store_v(ht + j, v);
            aie::store_v(ht + {{ C }} + j, aie::zeros<bfloat16, 32>());
        }
        {{ p }}_conv(wt, hl + {{ 2 * C }} * ((t + 1) & 3), hl + {{ 2 * C }} * ((t + 2) & 3), hl + {{ 2 * C }} * ((t + 3) & 3), ht, taps,
                     {{ "nullptr" if BLOCK else "cur + " ~ C ~ " * i" }}, out + {{ C }} * i);
        if (t >= n - 3 && t < n)  // (the window's rows of the last 3 valid tokens)
            al::copy<{{ C }}, 16>(SW(float, {{ w.snap }}) + {{ C }} * (t - n + 3), wt);
    }
    st[0] += {{ TB }};
}

// The conv's inputs of the chunk's last 3 valid tokens (n >= 3) -> out [3][{{ C }}] fp32
void {{ p }}_snap(float *__restrict ws, float *__restrict out)
{
    al::copy<{{ 3 * C }}, 16>(out, SW(float, {{ w.snap }}));
}

}  // extern "C"
{% endif %}
{% if op == "gate" %}
{% set sig = km.sigmoid(64, prec="bf16") %}
{{ sig.src }}

extern "C" {

// A token group's panels of the column's heads (x: {{ NP }} bfp16 panels of 8 tokens x 8 channels, then their gates [token 8]
// [{{ 8 * NP }}] bf16) times sigmoid of the gates -> out (the panels again). The panels' values are bf16-exact and so is the
// sigmoid: their bf16 product is exact before the bfp16 rounding.
void {{ p }}_run(const uint8_t *__restrict x, uint8_t *__restrict out)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    al::BIn<> ai((const bfp16ebs8 *)x);
    const bfloat16 *__restrict g = (const bfloat16 *)(x + {{ 72 * NP }});
    al::BOut<> po((bfp16ebs8 *)out);
    const al::BV I = al::eye();
    AIE_LOOP_NO_UNROLL
    for (int db = 0; db < {{ NP }}; db++) {
        al::MM8 t(aie::zeros<accfloat, 64>());
        t.mac(ai.pop(), aie::op_transpose(I));  // ([token][channel])
        const aie::vector<bfloat16, 64> s = {{ sig }}(al::gather<8, 8>(g + 8 * db, {{ 8 * NP }}));
        po.push(aie::mul(t.to_accum().template to_vector<bfloat16>(), s).template to_vector<bfp16ebs8>());
    }
}

}  // extern "C"
{% endif %}
{% if op == "blend" %}
// The blend core's workspace (bytes): wp [matrix 2 (-2 F, 2 G)][output tile 9][k block 8][hi, lo] bfp16 panels | gp [k block 8]
// [hi, lo] (a block's g) | c [matrix 2][output tile 9][64] fp32
{% set sig = km.sigmoid(64, prec="fp32") %}
{{ sig.src }}

extern "C" {

// Output tile t (matrix t / 9: F, G) of the core's rows of the forget and gain matrices (w: [output 8][64] bf16) -> its hi + lo
// panels per k block (rows: outputs, columns: k) of -2 F, 2 G (exact): the epilogue's sigmoid arguments
void {{ p }}_prm(const bfloat16 *__restrict w, float *__restrict ws, int32_t t)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const al::BV nI = al::neg_eye();
    const aie::vector<bfloat16, 64> sc = aie::broadcast<bfloat16, 64>(t < 9 ? -2.0f : 2.0f);
    al::BOut<> po((bfp16ebs8 *)(SW(uint8_t, {{ wb.wp }}) + {{ 16 * 72 }} * t));
    AIE_LOOP_NO_UNROLL
    for (int kb = 0; kb < 8; kb++) {
        al::BV h, l;
        al::split_hilo(aie::mul(al::gather<8, 8>(w + 8 * kb, 64), sc), nI, h, l);
        po.push(h);
        po.push(l);
    }
}

// A block of 8 tokens (x: g's halves [token 8][64] fp32 each, then cur_s, msg_s [token 8][{{ C }}] bf16: the column's slices) ->
// out [token 8][72] bf16 of the core's channels 72 r ..: g = g_a + g_b, a = -2 F g and b = 2 G g on the MMUL (g and the rows
// hi + lo: three products), (1 - tanh(F g)) cur + tanh(G g) msg = 2 sigmoid(a) cur + (2 sigmoid(b) - 1) msg (the sigmoids
// fp32, as bf16 hi + lo against the exact 2 cur, 2 msg: one rounding)
void {{ p }}_run(const bfloat16 *__restrict x, float *__restrict ws, bfloat16 *__restrict out, int32_t r)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const al::BV nI = al::neg_eye();
    const float *__restrict ga = (const float *)x, *__restrict gb = ga + 512;
    al::BOut<> go((bfp16ebs8 *)SW(uint8_t, {{ wb.gp }}));
    AIE_LOOP_NO_UNROLL
    for (int kb = 0; kb < 8; kb++) {  // (g's panel kb: [token 8][k 8])
        const aie::vector<float, 64> g = aie::add(al::gather<8, 8>(ga + 8 * kb, 64), al::gather<8, 8>(gb + 8 * kb, 64));
        al::BV h, l;
        al::split_hilo(aie::accum<accfloat, 64>(g), nI, h, l);
        go.push(h);
        go.push(l);
    }
    float *__restrict cc = SW(float, {{ wb.c }});
    AIE_LOOP_NO_UNROLL
    for (int t = 0; t < 18; t++) {  // (matrix t / 9, output tile t % 9)
        al::BInR<aie_dm_resource::a> gs((const bfp16ebs8 *)SW(const uint8_t, {{ wb.gp }}));
        al::BInR<aie_dm_resource::b> ws_((const bfp16ebs8 *)(SW(const uint8_t, {{ wb.wp }}) + {{ 16 * 72 }} * t));
        al::MM8 c(aie::zeros<accfloat, 64>());
        for (int kb = 0; kb < 8; kb++) {
            const al::BV gh = gs.pop(), gl = gs.pop(), wh = ws_.pop(), wl = ws_.pop();
            al::mm3(c, gh, gl, wh, wl);
        }
        aie::store_v(cc + 64 * t, c.template to_vector<float>());
    }
    const bfloat16 *__restrict cs = x + 2048 + 72 * r, *__restrict ms = x + 2048 + {{ 8 * C }} + 72 * r;
    const aie::vector<bfloat16, 64> two = aie::broadcast<bfloat16, 64>(2.0f), one = aie::broadcast<bfloat16, 64>(1.0f);
    AIE_LOOP_NO_UNROLL
    for (int j = 0; j < 9; j++) {  // (lane 8 token + o of output tile j)
        aie::vector<bfloat16, 64> fh, fl, gh, gl;
        al::split2<64>({{ sig }}(aie::load_v<64>(cc + 64 * j)), fh, fl);
        al::split2<64>({{ sig }}(aie::load_v<64>(cc + 576 + 64 * j)), gh, gl);
        const aie::vector<bfloat16, 64> m = al::gather<8, 8>(ms + 8 * j, {{ C }});
        const aie::vector<bfloat16, 64> c2 = aie::mul(al::gather<8, 8>(cs + 8 * j, {{ C }}), two).template to_vector<bfloat16>();
        const aie::vector<bfloat16, 64> m2 = aie::mul(m, two).template to_vector<bfloat16>();
        const aie::accum<accfloat, 64> y = aie::mac(aie::mac(aie::mac(aie::mul(fh, c2), fl, c2), gh, m2), gl, m2);
        const aie::vector<bfloat16, 64> yb = aie::msc(y, m, one).template to_vector<bfloat16>();
        for (int t = 0; t < 8; t++)
            aie::store_v(out + 72 * t + 8 * j, yb.template extract<8>(t));
    }
}

}  // extern "C"
{% endif %}
