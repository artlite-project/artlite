// Inkling's attention prep (``prefill.attn.ink``). Workspaces (bytes): the Q core's row ({{ HD }} fp32) | stage [d-block
// {{ ND }}][row 8][8] fp32 | rst [d-block 2][row 8][8] fp32; the K / V cores' row | stage (K) or vb [row 8][{{ HD }}] bf16 (V) | taps [4][{{ HD }}] bf16 | hist [slot 8][{{ HD }}] fp32 (the raw rows
// of the last 8 valid positions, slot = position % 8: the ring) | st [16] int32 (the token count)
#define PW(T, off) ((T *)((uint8_t *)ws + (off)))

namespace {

// v (n fp32) times min(1, thr / |v|) mul (Inkling's L2 clip, then tau and the score constant): the factor through
// vector lanes (the scalar unit has no floating point)
__attribute__((noinline)) void {{ p }}_clip(float *__restrict v, int n, float thr, float mul)
{
    aie::accum<accfloat, 16> ss = aie::zeros<accfloat, 16>();
    AIE_LOOP_NO_UNROLL
    for (int i = 0; i < n; i += 16) {
        aie::vector<bfloat16, 16> h, l;
        al::split2<16>(aie::load_v<16>(v + i), h, l);
        ss = aie::mac(aie::mac(aie::mac_square(ss, h), aie::add(h, h), l), l, l);
    }
    const float r = aie::invsqrt(aie::reduce_add(ss.template to_vector<float>()));
    aie::vector<float, 16> f = al::mulff<16>(aie::broadcast<float, 16>(r), aie::broadcast<float, 16>(thr));
    f = al::mulff<16>(aie::min(f, aie::broadcast<float, 16>(1.0f)), aie::broadcast<float, 16>(mul));
    AIE_LOOP_NO_UNROLL
    for (int i = 0; i < n; i += 16)
        aie::store_v(v + i, al::mulff<16>(aie::load_v<16>(v + i), f));
}

// Token tt's raw row (x: {{ HD }} bf16) into hist slot tt % 8, then its conv: (x + sum_k t_k x_(tt - 3 + k){{ " + sum_lag d_lag x_(tt - lag)" if FULL else "" }})
// sc -> row; a padding token (tt >= n) a zero row (its records zero until later tokens overwrite them)
__attribute__((noinline)) void {{ p }}_conv(const bfloat16 *__restrict x, float *__restrict hist, const bfloat16 *__restrict taps,
                                          float *__restrict row, int tt, int n, float sc)
{
    if (tt >= n) {  // (a padding token: zero records, whatever its rows hold: masked keys still weigh 2^-63 in P V)
        al::zero<{{ HD }}, 16>(row);
        return;
    }
    for (int i = 0; i < {{ HD }}; i += 32)
        aie::store_v(hist + {{ HD }} * (tt & 7) + i, aie::accum<accfloat, 32>(aie::load_v<32>(x + i)).template to_vector<float>());
{% if FULL %}
    const float *__restrict dl = (const float *)(x + {{ HD }});
{% endif %}
    AIE_LOOP_NO_UNROLL
    for (int i = 0; i < {{ HD }}; i += 16) {
        aie::accum<accfloat, 16> a(aie::load_v<16>(hist + {{ HD }} * (tt & 7) + i));
        for (int k = 0; k < 4; k++) {  // (tap k: position tt - 3 + k; tap 3 the current)
            aie::vector<bfloat16, 16> h, l;
            al::split2<16>(aie::load_v<16>(hist + {{ HD }} * ((tt - 3 + k) & 7) + i), h, l);
            const aie::vector<bfloat16, 16> w = aie::load_v<16>(taps + {{ HD }} * k + i);
            a = aie::mac(aie::mac(a, h, w), l, w);
        }
        aie::vector<float, 16> y = a.template to_vector<float>();
{% if FULL %}
        for (int lag = 0; lag < 4; lag++)  // (lag 0: the current row)
            y = aie::add(y, al::mulff<16>(aie::load_v<16>(hist + {{ HD }} * ((tt - lag) & 7) + i), aie::broadcast<float, 16>(dl[lag])));
{% endif %}
        aie::store_v(row + i, al::mulff<16>(y, aie::broadcast<float, 16>(sc)));
    }
}

}  // namespace

extern "C" {

// 8 tokens of the column's 3 query heads (x: per row the q GEMM's columns 0 .. {{ NQ }} of the column's slice: [q 3 x {{ HD }} |
// gate | r 3 x 16 at {{ OFF_R }} | sinks 3 fp32 at {{ OFF_S }}]; then the layer's q clip [3][{{ HD }}] and r clip [3][16] bf16 (448 with
// padding), the tokens' tau 8 fp32) -> per head its Q unit (hi then lo panels of q
// times its clip scales, L2-clipped to sqrt(512), times {{ "tau and " if FULL else "" }}the score constant), then per head [R hi | R lo] panels (r
// times its clip scales, clipped to 8, times {{ "tau and " if FULL else "" }}log2 e) and the sinks [head 3][token 8] fp32 (log2 units)
void {{ p }}_q(const bfloat16 *__restrict x, float *__restrict ws, bfloat16 *__restrict uo)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    float *__restrict row = PW(float, {{ wq.row }});
    float *__restrict st = PW(float, {{ wq.stage }});
    float *__restrict rs = PW(float, {{ wq.rst }});
    const bfloat16 *__restrict qc = x + {{ 8 * NQ }}, *__restrict rc = qc + {{ 3 * HD }};
    uint8_t *__restrict io = (uint8_t *)uo + {{ 3 * QUNIT }};
    float *__restrict sk = (float *)(io + {{ 6 * 144 }});
{% if FULL %}
    const float *__restrict tau = (const float *)(x + {{ 8 * NQ + 448 }});
{% endif %}
    for (int h = 0; h < 3; h++) {
        for (int r = 0; r < 8; r++) {
            const bfloat16 *__restrict xr = x + {{ NQ }} * r;
{% if FULL %}
            const float t = tau[r];
            const float qm = al::mulff<16>(aie::broadcast<float, 16>(t), aie::broadcast<float, 16>({{ SCALE }}f))[0];
{% else %}
            const float t = 1.0f, qm = {{ SCALE }}f;
{% endif %}
            for (int i = 0; i < {{ HD }}; i += 32)
                aie::store_v(row + i, aie::mul(aie::load_v<32>(xr + {{ HD }} * h + i),
                                               aie::load_v<32>(qc + {{ HD }} * h + i)).template to_vector<float>());
            {{ p }}_clip(row, {{ HD }}, {{ 512 ** 0.5 }}f, qm);
            al::stage_row<{{ ND }}>(row, st, r);
            aie::store_v(row, aie::mul(aie::load_v<16>(xr + {{ OFF_R }} + 16 * h), aie::load_v<16>(rc + 16 * h)).template to_vector<float>());
            {{ p }}_clip(row, 16, 8.0f, t);
            aie::store_v(row, al::log2e<16>(aie::load_v<16>(row)));
            al::stage_row<2>(row, rs, r);
        }
        al::encode_hilo<{{ ND }}, false>(st, (uint8_t *)uo + {{ QUNIT }} * h);
        al::encode_hilo<2, false>(rs, io + 288 * h);
    }
    for (int r = 0; r < 8; r++) {  // (the sinks: fp32 as bf16 pairs)
        aie::vector<float, 16> s = aie::zeros<float, 16>();
        s.insert(0, aie::load_v<4>((const float *)(x + {{ NQ }} * r + {{ OFF_S }})));
        const aie::vector<float, 16> l = al::log2e<16>(s);
        for (int h = 0; h < 3; h++)
            sk[8 * h + r] = l[h];
    }
}

{% for role, w in (("k", wk), ("v", wv)) %}
// The {{ role | upper }} core's constants (its part of the PRM object: the old ring's {{ role | upper }} rows [slot 8][{{ HD }}] fp32, the raw rows of
// positions p0 - 8 .. p0 - 1, then its taps [4][{{ HD }}] bf16); its token count reset
void {{ p }}_{{ role }}prm(const bfloat16 *__restrict prm, float *__restrict ws)
{
    al::copy<{{ 8 * HD }}, 16>(PW(float, {{ w.hist }}), (const float *)prm);
    al::copy<{{ 4 * HD }}, 16>(PW(bfloat16, {{ w.taps }}), prm + {{ 16 * HD }});
    PW(int32_t, {{ w.st }})[0] = 0;
}

// The ring after the chunk's last valid token ([slot 8][{{ HD }}] fp32, slot = position % 8) into out
void {{ p }}_{{ role }}ring(float *__restrict ws, bfloat16 *__restrict out)
{
    al::copy<{{ 8 * HD }}, 16>((float *)out, PW(float, {{ w.hist }}));
}

{% endfor %}
// 8 tokens of the KV head's raw K (x: rows of {{ PK }} bf16: K{{ " | its taps' deltas 4 fp32" if FULL else "" }}) -> record r of the group's K objects
// in out: K conv'd over the raw history (/ {{ "3" if FULL else "sqrt(5)" }}), L2-clipped to sqrt(512), as {{ "hi + lo panels" if KP == 2 else "single panels" }}; n: the chunk's valid tokens
void {{ p }}_k(const bfloat16 *__restrict x, float *__restrict ws, bfloat16 *__restrict out, int32_t r, int32_t n)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    int32_t *__restrict st = PW(int32_t, {{ wk.st }});
    float *__restrict row = PW(float, {{ wk.row }});
    float *__restrict stg = PW(float, {{ wk.stage }});
    for (int i = 0; i < 8; i++) {
        {{ p }}_conv(x + {{ PK }} * i, PW(float, {{ wk.hist }}), PW(const bfloat16, {{ wk.taps }}), row, st[0] + i, n, {{ CSC }}f);
        {{ p }}_clip(row, {{ HD }}, {{ 512 ** 0.5 }}f, 1.0f);
        al::stage_row<{{ ND }}>(row, stg, i);
    }
    st[0] += 8;
    uint8_t *__restrict rec = (uint8_t *)out + {{ KREC }} * r;
{% if KP == 2 %}
    al::encode_hilo<{{ ND }}, false>(stg, rec);
{% else %}
    al::encode_panel<{{ ND }}>(stg, rec);
{% endif %}
}

// 8 tokens of the KV head's raw V -> record r of the group's V object: V conv'd, RMS-normed (eps {{ eps }}), bf16, per 8 dims a
// panel of blocks over the positions
void {{ p }}_v(const bfloat16 *__restrict x, float *__restrict ws, bfloat16 *__restrict out, int32_t r, int32_t n)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    int32_t *__restrict st = PW(int32_t, {{ wv.st }});
    float *__restrict row = PW(float, {{ wv.row }});
    bfloat16 *__restrict vb = PW(bfloat16, {{ wv.vb }});
    for (int i = 0; i < 8; i++) {
        {{ p }}_conv(x + {{ PK }} * i, PW(float, {{ wv.hist }}), PW(const bfloat16, {{ wv.taps }}), row, st[0] + i, n, {{ CSC }}f);
        aie::accum<accfloat, 16> ss = aie::zeros<accfloat, 16>();
        for (int j = 0; j < {{ HD }}; j += 16) {
            aie::vector<bfloat16, 16> h, l;
            al::split2<16>(aie::load_v<16>(row + j), h, l);
            ss = aie::mac(aie::mac(aie::mac_square(ss, h), aie::add(h, h), l), l, l);
        }
        aie::vector<float, 16> ms = aie::zeros<float, 16>();
        ms[0] = aie::reduce_add(ss.template to_vector<float>());
        const aie::vector<float, 16> iv = aie::broadcast<float, 16>(al::inv_rms<{{ HD }}, 1>(ms, {{ eps }}f)[0]);
        for (int j = 0; j < {{ HD }}; j += 16)
            aie::store_v(vb + {{ HD }} * i + j, aie::accum<accfloat, 16>(al::mulff<16>(aie::load_v<16>(row + j), iv)).template to_vector<bfloat16>());
    }
    st[0] += 8;
    al::BOut<> o((bfp16ebs8 *)((uint8_t *)out + {{ 72 * ND }} * r));
    for (int db = 0; db < {{ ND }}; db++)
        o.push(al::vpan<{{ HD }}>(vb, db));
}

}  // extern "C"
