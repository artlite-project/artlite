        al::BInR<aie_dm_resource::b> ks((const bfp16ebs8 *)(uu ? k1 : k0));
        al::MM8 c00(b0), c01(b0), c10(b1), c11(b1);  // (row block 2 pr + e, record 2 uu + r)
