        const aie::accum<accfloat, 64> b0(aie::load_v<64>(bias + 128 * pr)), b1(aie::load_v<64>(bias + 128 * pr + 64));
        float *__restrict s = sc + {{ 128 * CR }} * pr + 256 * uu;
