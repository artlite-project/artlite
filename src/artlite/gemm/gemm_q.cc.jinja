            aie::vector<bfloat16, 64> hv = aie::mul(aie::load_v<64>(py), aie::load_v<64>(pu)).template to_vector<bfloat16>();
            out.push(aie::accum<accfloat, 64>(hv).template to_vector<bfp16ebs8>());
            pu += 128;
