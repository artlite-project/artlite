
extern "C" {

// The region's payloads 0 .. 2 (12 KB: taps 0 .. 3, taps 4 .. 6 and history rows 8, 9, history rows 0 .. 7; held for
// the chunk: its taps): the window's rows 0 .. 5
void {{ p }}_cinit(const bfloat16 *__restrict r, bfloat16 *__restrict win, int32_t *__restrict st, int32_t n)
{
    st[0] = 0;  // (the next group's first token)
    st[1] = n;
    const bfloat16 *__restrict src = r + {{ 2 * XPAY }};
    AIE_LOOP_NO_UNROLL
    for (int i = 0; i < {{ KEEP * CH }}; i += 64) {
        aie::store_v(win, aie::load_v<64>(src));
        win += 64;
        src += 64;
    }
}

// 8 tokens t0 .. t0 + 7 of G (rows [B | C | x]) -> 32 panels of y (8 tokens x 8 channels); the token n - 1 among them:
// the 6 rows of bx up to it into hk (the history's output object, held for the chunk)
void {{ p }}_cgrp(const bfloat16 *__restrict g, const bfloat16 *__restrict taps, bfloat16 *__restrict win,
                  float *__restrict yt, bfloat16 *__restrict hk, bfloat16 *__restrict out, int32_t *__restrict st)
{
    aie::set_rounding(aie::rounding_mode::conv_even);
    const int t0 = st[0], n = st[1];
    st[0] = t0 + 8;
    // (the (token, channel block) nests as single loops, G and the taps walked in 2-D: 3399 cycles a call; the nests
    // 4624)
    {
        const bfloat16 *__restrict pg = g;
        bfloat16 *__restrict pw = win + {{ CH * KEEP }};
        dims_2d_t wg = dims_2d_from_steps({{ CH // 64 }}, 64, {{ ROW }});
        AIE_LOOP_NO_UNROLL
        for (int tv = 0; tv < {{ 8 * CH // 64 }}; tv++) {  // (token tv / {{ CH // 64 }}, channels 64 (tv % {{ CH // 64 }}) ..)
            aie::store_v(pw, aie::mul(aie::load_v<64>(pg), aie::load_v<64>(pg + {{ 2 * CH }})).template to_vector<bfloat16>());
            pw += 64;
            pg = add_2d_ptr(pg, wg);
        }
    }
    {
        const bfloat16 *__restrict pr = win, *__restrict pt = taps, *__restrict pc = g + {{ CH }};
        float *__restrict py = yt;
        dims_2d_t wt = dims_2d_from_steps({{ CH // 64 }}, 64, 0), wc = dims_2d_from_steps({{ CH // 64 }}, 64, {{ ROW }});
        AIE_LOOP_NO_UNROLL
        for (int tv = 0; tv < {{ 8 * CH // 64 }}; tv++) {
            aie::accum<accfloat, 64> acc = aie::zeros<accfloat, 64>();
            AIE_LOOP_UNROLL_FULL  // (the taps in one block)
            for (int k = 0; k < {{ WIDTH }}; k++) {
                const aie::vector<bfloat16, 64> r = aie::load_v<64>(pr + {{ CH }} * k);
                acc = aie::mac(acc, aie::load_v<64>(pt + {{ 2 * CH }} * k), r);
                acc = aie::mac(acc, aie::load_v<64>(pt + {{ 2 * CH }} * k + {{ CH }}), r);
            }
            aie::vector<bfloat16, 64> ah, al;
            al::split2<64>(acc, ah, al);
            const aie::vector<bfloat16, 64> c = aie::load_v<64>(pc);
            aie::store_v(py, aie::mac(aie::mul(ah, c), al, c).template to_vector<float>());
            pr += 64;
            py += 64;
            pt = add_2d_ptr(pt, wt);
            pc = add_2d_ptr(pc, wc);
        }
    }
    {
        al::BOut<> o((bfp16ebs8 *)out);
        AIE_LOOP_NO_UNROLL
        for (int j = 0; j < {{ CH // 8 }}; j++)
            o.push(aie::accum<accfloat, 64>(al::gather<8, 8>(yt + 8 * j, {{ CH }})).template to_vector<bfp16ebs8>());
    }
    if (n - 1 >= t0 && n - 1 < t0 + 8) {  // (window rows n - 6 - t0 + 6 .. : the 6 tokens up to n - 1)
        const bfloat16 *__restrict src = win + {{ CH }} * (n - t0);
        bfloat16 *__restrict dst = hk;
        AIE_LOOP_NO_UNROLL
        for (int i = 0; i < {{ KEEP * CH }}; i += 64) {
            aie::store_v(dst, aie::load_v<64>(src));
            dst += 64;
            src += 64;
        }
    }
    {  // (the next group's rows before it; walked pointers: an index shared by both ran at II 9 - 10)
        const bfloat16 *__restrict src = win + {{ 8 * CH }};
        bfloat16 *__restrict dst = win;
        AIE_LOOP_NO_UNROLL
        for (int i = 0; i < {{ KEEP * CH }}; i += 64) {
            aie::store_v(dst, aie::load_v<64>(src));
            dst += 64;
            src += 64;
        }
    }
}

}  // extern "C"
