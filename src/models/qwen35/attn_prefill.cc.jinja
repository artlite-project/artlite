// Scores of a pair of K records (records 2 k2, 2 k2 + 1, [d-block][record 2]) for each row panel: b + Q hi K + Q lo K (q: per
// panel per d-block the Q panels hi, lo), one loop of two panel streams and two MMUL chains
void {{ p }}_qk(const bfloat16 *__restrict q, const bfloat16 *__restrict kr, float *__restrict ws, int32_t k2)
{
{% if "qk" in ablate %}
    return;
{% endif %}
{% if "ev_qk" in ablate %}
