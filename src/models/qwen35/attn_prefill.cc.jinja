void {{ p }}_qsel(const bfloat16 *__restrict a, bfloat16 *__restrict q, int32_t i, int32_t me)
{
    const unsigned k = (unsigned)(i - me);
    if (k < {{ R }}u)
        al::copy<{{ SLOT // 2 }}, 32>(q + {{ SLOT // 2 }} * k, a);
