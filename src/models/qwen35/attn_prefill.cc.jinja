            hv.insert(q, aie::broadcast<int16, 8>(hi[t + q]));
        }
        aie::store_v(AW(int16_t, {{ w.lv }}) + 128 * j, lv);
        aie::store_v(AW(int16_t, {{ w.lv }}) + 128 * j + 64, hv);
    }
    int16_t *__restrict jl = AW(int16_t, {{ w.jl }});
    for (int l = 0; l < 64; l += 2)
        ((int32_t *)jl)[l / 2] = (l & 7) | ((l + 1) & 7) << 16;
}

